{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/validate.py:*)",
      "Bash(python scripts/build.py:*)",
      "Bash(mkdocs build:*)",
      "Bash(mkdocs serve:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "PowerShell(python scripts/validate.py:*)",
      "PowerShell(python scripts/build.py:*)",
      "PowerShell(mkdocs build:*)",
      "PowerShell(mkdocs serve:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard_generated.py",
            "timeout": 15,
            "statusMessage": "Checking file is not generated..."
          }
        ]
      }
    ]
  }
}
