@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wt: <https://samrepository.github.io/Web_Technologies_MindMap/ns#> .
@prefix wtc: <https://samrepository.github.io/Web_Technologies_MindMap/concept/> .
@prefix wts: <https://samrepository.github.io/Web_Technologies_MindMap/scheme/> .

wtc:angular a skos:Concept ;
    rdfs:seeAlso <https://angular.dev/>,
        <https://ar.wikipedia.org/wiki/%D8%A3%D9%86%D8%AC%D9%88%D9%84%D8%A7%D8%B1>,
        <https://en.wikipedia.org/wiki/Angular_(web_framework)> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "إطار عمل مبنيّ على TypeScript لبناء تطبيقات ويب ديناميكية، طوّرته غوغل. ويقدّم Angular حلًّا متكاملًا جاهزًا يشمل التوجيه والنماذج وعميل HTTP وحقن التبعيات."@ar,
        "A TypeScript-based framework for building dynamic web applications, developed by Google. Angular provides a complete solution out of the box, including routing, forms, HTTP client, and dependency injection."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Angular"@en ;
    skos:related wtc:angularjs ;
    wt:status "current" .

wtc:aws a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AE%D8%AF%D9%85%D8%A7%D8%AA_%D8%A3%D9%85%D8%A7%D8%B2%D9%88%D9%86_%D9%88%D9%8A%D8%A8>,
        <https://aws.amazon.com/>,
        <https://en.wikipedia.org/wiki/Amazon_Web_Services> ;
    skos:broader wtc:cloud-computing ;
    skos:definition "تقدّم خدمات أمازون السحابية (AWS) حزمة من خدمات الحوسبة السحابية تشكّل منصّة حوسبة عند الطلب."@ar,
        "Amazon Web Services (AWS) offers a suite of cloud computing services that make up an on-demand computing platform."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "AWS"@en ;
    wt:status "current" .

wtc:big-data a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA_%D8%B6%D8%AE%D9%85%D8%A9>,
        <https://en.wikipedia.org/wiki/Big_data> ;
    skos:broader wtc:databases-2 ;
    skos:definition "يشير إلى مجموعات بيانات ضخمة جدًّا تتطلّب أدوات وتقنيات متقدّمة لمعالجتها وتحليلها. وتتميّز بالحجم والتنوّع في أنواع البيانات والسرعة في المعالجة والصدقية في دقّة البيانات. وتُستعمل البيانات الضخمة لاستخلاص الرؤى والأنماط في مجالات كالمالية والرعاية الصحّية ووسائل التواصل الاجتماعي."@ar,
        "Refers to extremely large data sets that require advanced tools and techniques to process and analyze. It is characterized by its volume, variety (types of data), velocity (speed of processing), and veracity (data accuracy). Big Data is used to uncover insights and patterns in fields like finance, healthcare, and social media."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Big Data"@en ;
    wt:status "current" .

wtc:bun a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%A7%D9%86_%28%D8%A8%D9%8A%D8%A6%D8%A9_%D8%AA%D8%B4%D8%BA%D9%8A%D9%84_%D8%AC%D8%A7%D9%81%D8%A7_%D8%B3%D9%83%D8%B1%D9%8A%D8%A8%D8%AA%29>,
        <https://bun.sh/>,
        <https://en.wikipedia.org/wiki/Bun_(software)> ;
    skos:broader wtc:server-side-programming ;
    skos:definition "بيئة تشغيل لجافاسكريبت مبنيّة على JavaScriptCore، تضمّ أيضًا مدير حزم ومشغّل اختبارات ومُحزِّمًا في ثنائية واحدة، وتنافس Node أساسًا في سرعة الإقلاع والتثبيت."@ar,
        "A JavaScript runtime built on JavaScriptCore that also bundles a package manager, test runner and bundler into one binary, competing with Node primarily on startup and install speed."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Bun"@en ;
    skos:related wtc:node-js ;
    wt:status "current" .

wtc:client-side a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D9%85%D9%88%D8%B0%D8%AC_%D8%A7%D9%84%D8%AE%D8%A7%D8%AF%D9%85_%D9%88%D8%A7%D9%84%D8%B9%D9%85%D9%8A%D9%84>,
        <https://en.wikipedia.org/wiki/Client-side> ;
    skos:broader wtc:browsers ;
    skos:definition "جانب العميل يشير إلى العمليات التي ينفّذها العميل، وهو في معظم الحالات متصفّح المستخدم. وتشمل تقنياته HTML وCSS وJavaScript، وتُنفَّذ على جهاز المستخدم لا على الخادوم. وتتيح هذه المقاربة واجهات ديناميكية وتجارب ويب تفاعلية."@ar,
        "Client-side refers to operations that are performed by the client, which in most cases is the user's web browser. Client-side technologies include HTML, CSS, and JavaScript, which are executed on the user's device rather than on the server. This approach allows for dynamic user interfaces and interactive web experiences."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Client-Side"@en ;
    wt:status "current" .

wtc:cls a skos:Concept ;
    rdfs:seeAlso <https://web.dev/articles/cls> ;
    skos:broader wtc:core-web-vitals ;
    skos:definition "مقدار ما يتحرّك من المحتوى المرئي على نحو غير متوقّع أثناء التحميل — وهو المقياس الخاصّ بالصفحة التي تنزاح في اللحظة التي تهمّ فيها بالنقر."@ar,
        "How much visible content moves around unexpectedly while loading — the metric for the page that shifts just as you go to tap something."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "CLS (Cumulative Layout Shift)"@en ;
    wt:status "current" .

wtc:container-queries a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_containment/Container_queries>,
        <https://www.w3.org/TR/css-contain-3/> ;
    skos:broader wtc:css3 ;
    skos:definition "قواعد تنسيق تستجيب لحجم حاوية المكوّن نفسه لا لحجم إطار العرض. وهذا ما لم تستطع استعلامات الوسائط التعبير عنه قطّ: مكوّن قابل لإعادة الاستعمال حقًّا، يتكيّف أينما وُضِع دون أن يعرف شيئًا عن الصفحة من حوله."@ar,
        "Styling rules that respond to the size of a component's own container rather than the size of the viewport. This is what media queries could never express: a genuinely reusable component that adapts wherever it is placed, without knowing anything about the page around it."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Container Queries"@en ;
    wt:status "emerging" .

wtc:content-security-policy a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/CSP>,
        <https://www.w3.org/TR/CSP3/> ;
    skos:broader wtc:defenses ;
    skos:definition "ترويسة HTTP تعلن بها الصفحة المصادر التي يجوز لها تحميل النصوص البرمجية والأنماط وسائر الموارد منها. والمتصفّح هو من يفرضها، ممّا يحوّل معظم حالات البرمجة العابرة للمواقع من اختراق كامل إلى طلب محجوب."@ar,
        "An HTTP header by which a page declares which sources it may load scripts, styles and other resources from. The browser enforces it, which turns most cross-site scripting from a full compromise into a blocked request."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "CSP (Content Security Policy)"@en ;
    skos:related wtc:xss ;
    wt:status "current" .

wtc:cors a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D9%82%D8%A7%D8%B3%D9%85_%D8%A7%D9%84%D9%85%D9%88%D8%A7%D8%B1%D8%AF_%D8%B9%D8%A8%D8%B1_%D8%A7%D9%84%D8%A3%D8%B5%D9%88%D9%84>,
        <https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/CORS>,
        <https://en.wikipedia.org/wiki/Cross-origin_resource_sharing> ;
    skos:broader wtc:defenses ;
    skos:definition "الآلية التي يوافق بها الخادوم على أن تقرأه صفحات من أصول أخرى. وهي ترخي سياسة الأصل الواحد بصورة محكومة؛ فهي نظام أذونات لا قيد مفروض على الخادوم."@ar,
        "The mechanism by which a server opts in to being read by pages from other origins. It relaxes the same-origin policy in a controlled way; it is a permission system, not a restriction imposed on the server."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "CORS (Cross-Origin Resource Sharing)"@en ;
    skos:related wtc:restful-apis ;
    wt:status "current" .

wtc:csrf a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%B2%D9%88%D9%8A%D8%B1_%D8%A7%D9%84%D8%B7%D9%84%D8%A8_%D8%B9%D8%A8%D8%B1_%D8%A7%D9%84%D9%85%D9%88%D8%A7%D9%82%D8%B9>,
        <https://en.wikipedia.org/wiki/Cross-site_request_forgery> ;
    skos:broader wtc:threats ;
    skos:definition "نوع من الهجمات يخدع فيه موقع خبيث متصفّحَ المستخدم فيدفعه إلى تنفيذ إجراءات على موقع آخر دون موافقته، ممّا يؤدّي إلى معاملات أو تغييرات غير مصرَّح بها في البيانات."@ar,
        "A type of attack where a malicious website tricks a user's browser into performing actions on another site without their consent, leading to unauthorized transactions or data changes."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "CSRF (Cross-Site Request Forgery)"@en ;
    wt:status "current" .

wtc:css-grid a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout>,
        <https://www.w3.org/TR/css-grid-1/> ;
    skos:broader wtc:css3 ;
    skos:definition "نظام تخطيط ثنائي الأبعاد يضع العناصر في صفوف وأعمدة تُعلَن على الحاوية. وقد حلّ محلّ الحيل القائمة على float والجداول التي كان التخطيط يتطلّبها سابقًا، وهو يكمّل Flexbox الذي يعالج بُعدًا واحدًا في كلّ مرّة."@ar,
        "A two-dimensional layout system that positions elements in rows and columns declared on the container. It replaced the float- and table-based hacks that page layout previously required, and complements Flexbox, which handles one dimension at a time."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "CSS Grid Layout"@en ;
    wt:status "current" .

wtc:csv a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%82%D9%8A%D9%85_%D9%85%D9%81%D8%B5%D9%88%D9%84%D8%A9_%D8%A8%D9%81%D9%88%D8%A7%D8%B5%D9%84>,
        <https://en.wikipedia.org/wiki/Comma-separated_values> ;
    skos:broader wtc:data-exchange-formats ;
    skos:definition "القيم المفصولة بفواصل (CSV) صيغة ملفّ بسيطة تُستعمل لتخزين البيانات الجدولية، كجدول بيانات أو قاعدة بيانات. كلّ سطر في الملفّ يقابل سجلًّا، وكلّ حقل داخل السجلّ تفصله فاصلة. وتُستعمل هذه الملفّات كثيرًا لتبادل البيانات بين الأنظمة والتطبيقات المختلفة، لبساطتها ودعمها الواسع."@ar,
        "CSV is a simple file format used to store tabular data, such as a spreadsheet or database. Each line in a CSV file corresponds to a record, and each field in the record is separated by a comma. CSV files are commonly used for data exchange between different systems and applications due to their simplicity and wide support."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "CSV (Comma-Separated Values)"@en ;
    wt:status "current" .

wtc:ddos a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%87%D8%AC%D9%85%D8%A7%D8%AA_%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D8%A7%D9%86_%D9%85%D9%86_%D8%A7%D9%84%D8%AE%D8%AF%D9%85%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Denial-of-service_attack> ;
    skos:broader wtc:threats ;
    skos:definition "هجوم يُغرِق موقعًا أو خادومًا بسيل من حركة الإنترنت من مصادر متعدّدة، فيجعله غير متاح للمستخدمين الشرعيين."@ar,
        "An attack that overwhelms a website or server with a flood of internet traffic from multiple sources, making it unavailable to legitimate users."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "DDoS (Distributed Denial of Service)"@en ;
    wt:status "current" .

wtc:deno a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AF%D9%8A%D9%86%D9%88_%28%D8%A8%D8%B1%D9%85%D8%AC%D9%8A%D8%A9%29>,
        <https://deno.com/>,
        <https://en.wikipedia.org/wiki/Deno_(software)> ;
    skos:broader wtc:server-side-programming ;
    skos:definition "بيئة تشغيل لجافاسكريبت وTypeScript من صاحب فكرة Node الأصلي، تعالج ما ندم عليه في تصميم Node: يعمل TypeScript دون خطوة بناء، والوصول إلى الملفّات والشبكة والبيئة ممنوع ما لم يُمنَح صراحةً."@ar,
        "A JavaScript and TypeScript runtime from Node's original creator, addressing design regrets in Node: TypeScript runs without a build step, and file, network and environment access are denied unless explicitly granted."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Deno"@en ;
    skos:related wtc:node-js,
        wtc:typescript ;
    wt:status "current" .

wtc:developer-mode a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A3%D8%AF%D9%88%D8%A7%D8%AA_%D8%AA%D8%B7%D9%88%D9%8A%D8%B1_%D8%A7%D9%84%D9%85%D9%88%D8%A7%D9%82%D8%B9>,
        <https://developer.mozilla.org/en-US/docs/Learn/Common_questions/What_are_browser_developer_tools>,
        <https://en.wikipedia.org/wiki/Web_development_tools> ;
    skos:broader wtc:browsers ;
    skos:definition "وضع المطوّر، أو أدوات المطوّر، مجموعة أدوات توفّرها المتصفّحات تتيح للمطوّرين فحص تطبيقات الويب وتنقيحها داخل المتصفّح مباشرةً. ويشمل لوحة العناصر لفحص HTML وCSS، والطرفية (Console) لتشغيل جافاسكريبت، ولوحة الشبكة لتحليل طلبات HTTP."@ar,
        "Developer Mode, or Developer Tools, is a set of tools provided by web browsers that allow developers to inspect and debug web applications directly in the browser. Developer Mode includes features like the Elements panel for inspecting HTML and CSS, the Console for running JavaScript, and the Network panel for analyzing HTTP requests."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Developer Mode"@en ;
    wt:status "current" .

wtc:dns a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D8%B8%D8%A7%D9%85_%D8%A3%D8%B3%D9%85%D8%A7%D8%A1_%D8%A7%D9%84%D9%86%D8%B7%D8%A7%D9%82%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Domain_Name_System>,
        <https://www.iana.org/domains/root> ;
    skos:broader wtc:protocols ;
    skos:definition "نظام أسماء النطاقات (DNS) يترجم أسماء النطاقات المفهومة للإنسان إلى عناوين بروتوكول الإنترنت (IP addresses) اللازمة لتحديد موقع خدمات الحاسوب والأجهزة والتعرّف عليها."@ar,
        "The Domain Name System (DNS) translates human-friendly domain names into IP addresses required for locating and identifying computer services and devices."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "DNS"@en ;
    wt:status "current" .

wtc:gcp a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D9%86%D8%B5%D8%A9_%D8%AC%D9%88%D8%AC%D9%84_%D8%A7%D9%84%D8%B3%D8%AD%D8%A7%D8%A8%D9%8A%D8%A9>,
        <https://cloud.google.com/>,
        <https://en.wikipedia.org/wiki/Google_Cloud_Platform> ;
    skos:broader wtc:cloud-computing ;
    skos:definition "منصّة غوغل السحابية (GCP) حزمة من خدمات الحوسبة السحابية تقدّمها غوغل. وتوفّر طيفًا من الخدمات للحوسبة والتخزين وتحليل البيانات وتعلُّم الآلة وتطوير التطبيقات، تعمل كلّها على البنية التحتية نفسها التي تستعملها غوغل داخليًّا لمنتجاتها كبحث غوغل ويوتيوب. وهي تمكّن الشركات من بناء التطبيقات ونشرها وتوسيعها بكفاءة على شبكة عالمية."@ar,
        "Google Cloud Platform (GCP) is a suite of cloud computing services offered by Google. It provides a range of services for computing, storage, data analytics, machine learning, and application development, all running on the same infrastructure that Google uses internally for its products like Google Search and YouTube. GCP enables businesses to build, deploy, and scale applications efficiently on a global network."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "GCP"@en ;
    wt:status "current" .

wtc:heroku a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Heroku>,
        <https://www.heroku.com/> ;
    skos:broader wtc:cloud-computing ;
    skos:definition "منصّة سحابية كخدمة (PaaS) تدعم عدّة لغات برمجة، وتُستعمل لنشر التطبيقات وإدارتها وتوسيعها."@ar,
        "A cloud platform as a service (PaaS) supporting several programming languages, used for deploying, managing, and scaling applications."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Heroku"@en ;
    wt:status "legacy" .

wtc:htmx a skos:Concept ;
    rdfs:seeAlso <https://htmx.org/> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "مكتبة صغيرة تتيح لسمات HTML إصدار طلبات AJAX وإبدال ما يعود من HTML داخل الصفحة. وهي تعكس عمدًا نموذج تطبيق الصفحة الواحدة: يبقى الخادوم يصيّر HTML، ولا يقيم في المتصفّح إلّا قدر ضئيل من حالة التطبيق."@ar,
        "A small library that lets HTML attributes issue AJAX requests and swap the returned HTML into the page. It deliberately inverts the single-page-app model: the server keeps rendering HTML, and very little application state lives in the browser."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "htmx"@en ;
    skos:related wtc:spas ;
    wt:status "current" .

wtc:http-2 a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%88%D8%AA%D9%88%D9%83%D9%88%D9%84_%D9%86%D9%82%D9%84_%D8%A7%D9%84%D9%86%D8%B5_%D8%A7%D9%84%D9%81%D8%A7%D8%A6%D9%82/2>,
        <https://en.wikipedia.org/wiki/HTTP/2>,
        <https://httpwg.org/specs/rfc9113.html> ;
    skos:broader wtc:http-https ;
    skos:definition "مراجعة كبرى لبروتوكول HTTP تحتفظ بالدلالات نفسها لكنّها تغيّر طريقة انتقال الرسائل: تُضفَّر الطلبات (multiplexing) على اتّصال واحد وتُضغَط الترويسات، ما يُغني عن الحيل التي كانت المواقع تلجأ إليها لإخفاء سلوك HTTP/1.1 القائم على طلب واحد في كلّ مرّة."@ar,
        "A major revision of HTTP that keeps the same semantics but changes how messages travel: requests are multiplexed over a single connection and headers are compressed, removing the need for the workarounds sites used to hide HTTP/1.1's one-request-at-a-time behaviour."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "HTTP/2"@en ;
    wt:status "current" .

wtc:iaas a skos:Concept ;
    skos:broader wtc:cloud-computing ;
    skos:definition "موارد حوسبة مُحاكاة افتراضيًّا كالخواديم والتخزين، مثل AWS EC2 وAzure."@ar,
        "Virtualized computing resources like servers and storage (e.g., AWS EC2, Azure)."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "IaaS (Infrastructure as a Service)"@en ;
    wt:status "current" .

wtc:import-maps a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/script/type/importmap>,
        <https://html.spec.whatwg.org/multipage/webappapis.html#import-maps> ;
    skos:broader wtc:esm ;
    skos:definition "كتلة JSON داخل الصفحة تخبر المتصفّح كيف يحلّ أسماء الوحدات المجرّدة، مثل import 'lodash'، إلى عناوين حقيقية. وتتيح للمشروع استعمال الاستيرادات المسمّاة مباشرةً في المتصفّح دون حاجة إلى مُحزِّم يعيد كتابتها أوّلًا."@ar,
        "A JSON block in the page that tells the browser how to resolve bare module names such as `import 'lodash'` to real URLs. It allows a project to use named imports directly in the browser without a bundler rewriting them first."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Import Maps"@en ;
    wt:status "emerging" .

wtc:inp a skos:Concept ;
    rdfs:seeAlso <https://web.dev/articles/inp> ;
    skos:broader wtc:core-web-vitals ;
    skos:definition "كم تستغرق الصفحة حتى تستجيب استجابة مرئية لمدخلات المستخدم، على امتداد الزيارة كلّها. وقد حلّ محلّ «تأخّر أوّل إدخال» الذي كان يقيس التفاعل الأوّل وحده فيغفل معظم المشكلة."@ar,
        "How long the page takes to visibly respond to user input, across the whole visit. It replaced First Input Delay, which only measured the first interaction and so missed most of the problem."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "INP (Interaction to Next Paint)"@en ;
    wt:status "current" .

wtc:iri a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Internationalized_Resource_Identifier>,
        <https://www.w3.org/International/O-URL-and-ident.html> ;
    skos:broader wtc:data-acces ;
    skos:definition "المعرّف الدولي للموارد (IRI) امتداد للمعرّف الموحّد للموارد (URI) يسمح بإدراج محارف خارج ASCII. وتتيح المعرّفات الدولية استعمال محارف من لغات وكتابات متعدّدة، كالحروف المشكولة والصينية والعربية والسيريلية، داخل عناوين الويب، فتوفّر صيغةً أشمل وأيسر وصولًا على المستوى العالمي لتعريف الموارد على الإنترنت. ويمكن تحويلها إلى معرّفات URI للتوافق الرجعي مع الأنظمة التي لا تدعم سوى محارف ASCII."@ar,
        "IRI is an extension of the Uniform Resource Identifier (URI) that allows for the inclusion of non-ASCII characters. IRIs enable the use of characters from multiple languages and scripts, such as accented letters, Chinese, Arabic, or Cyrillic, within web addresses. This provides a more inclusive and globally accessible format for resource identification on the internet. IRIs can be converted to URIs for backward compatibility with systems that only support ASCII characters."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "IRI (Internationalized Resource Identifier)"@en ;
    skos:related wtc:unicode ;
    wt:status "current" .

wtc:jquery a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AC%D9%8A_%D9%83%D9%88%D9%8A%D8%B1%D9%8A>,
        <https://en.wikipedia.org/wiki/JQuery>,
        <https://jquery.com/> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "مكتبة جافاسكريبت سريعة وصغيرة وغنية بالخصائص، تبسّط اجتياز شجرة DOM في HTML والتعامل معها."@ar,
        "A fast, small, and feature-rich JavaScript library that simplifies HTML DOM tree traversal and manipulation."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "jQuery"@en ;
    skos:related wtc:dom-manipulation ;
    wt:status "legacy" .

wtc:json a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/JSON>,
        <https://en.wikipedia.org/wiki/JSON>,
        <https://www.json.org/json-en.html> ;
    skos:broader wtc:data-exchange-formats ;
    skos:definition "ترميز كائنات جافاسكريبت (JSON) صيغة خفيفة لتبادل البيانات، يسهل على الإنسان قراءتها وكتابتها، وعلى الآلة تحليلها وتوليدها."@ar,
        "JavaScript Object Notation (JSON) is a lightweight data-interchange format that is easy for humans to read and write, and easy for machines to parse and generate."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "JSON"@en ;
    skos:related wtc:restful-apis ;
    wt:status "current" .

wtc:lcp a skos:Concept ;
    rdfs:seeAlso <https://web.dev/articles/lcp> ;
    skos:broader wtc:core-web-vitals ;
    skos:definition "كم يستغرق أكبر عنصر في إطار العرض حتى يُصيَّر — وهو مؤشّر بديل عن اللحظة التي تبدو فيها الصفحة محمَّلة لمن ينتظرها."@ar,
        "How long until the largest element in the viewport has rendered — a proxy for when the page looks loaded to the person waiting."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "LCP (Largest Contentful Paint)"@en ;
    wt:status "current" .

wtc:mvc a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D9%85%D8%B7_%D9%88%D8%B9%D8%B1%D8%B6_%D9%88%D9%85%D8%AA%D8%AD%D9%83%D9%85>,
        <https://en.wikipedia.org/wiki/Model–view–controller> ;
    skos:broader wtc:odoo-framework ;
    skos:definition "النموذج والعرض والمتحكّم (MVC) نمط تصميم يُستعمل في تطوير تطبيقات الويب، ويقسّم التطبيق إلى ثلاثة مكوّنات مترابطة."@ar,
        "Model-View-Controller (MVC) is a design pattern used for developing web applications. It divides an application into three interconnected components."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "MVC"@en ;
    skos:related wtc:django,
        wtc:flask ;
    wt:status "current" .

wtc:next-js a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D9%83%D8%B3%D8%AA_%D8%AC%D9%8A_%D8%A5%D8%B3>,
        <https://en.wikipedia.org/wiki/Next.js>,
        <https://nextjs.org/> ;
    skos:broader wtc:meta-frameworks ;
    skos:definition "أوسع أطر React الفوقية انتشارًا، ويوفّر توجيهًا قائمًا على الملفّات، وتصييرًا من جانب الخادوم وتصييرًا ساكنًا، ومكوّنات خادوم، في سلسلة أدوات واحدة."@ar,
        "The most widely used React meta-framework, providing file-based routing, server-side and static rendering, and server components in one toolchain."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Next.js"@en ;
    skos:related wtc:react-js ;
    wt:status "current" .

wtc:nlg a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D9%88%D9%84%D9%8A%D8%AF_%D8%A7%D9%84%D9%84%D8%BA%D8%A7%D8%AA_%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%B9%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Natural-language_generation> ;
    skos:broader wtc:nlp-nlu-and-nlg ;
    skos:definition "توليد اللغة الطبيعية (NLG) يشير إلى قدرة أنظمة الذكاء الاصطناعي على إنتاج مخرجات لغوية طبيعية متماسكة وملائمة للسياق، انطلاقًا من البيانات والمدخلات."@ar,
        "NLG refers to the ability of AI systems to generate coherent and contextually appropriate natural language outputs based on data and inputs."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "NLG"@en ;
    wt:status "current" .

wtc:nlu a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%81%D9%87%D9%85_%D8%A7%D9%84%D9%84%D8%BA%D8%A7%D8%AA_%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%B9%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Natural-language_understanding> ;
    skos:broader wtc:nlp-nlu-and-nlg ;
    skos:definition "فهم اللغة الطبيعية (NLU) حقل فرعي من معالجة اللغات الطبيعية يركّز على قدرة الآلة على فهم المعنى الكامن وراء مدخلات اللغة الطبيعية وتأويله."@ar,
        "NLU is a subfield of NLP that focuses on the machine's ability to understand and interpret the meaning behind natural language inputs."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "NLU"@en ;
    wt:status "current" .

wtc:nosql a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%82%D8%A7%D8%B9%D8%AF%D8%A9_%D8%A7%D9%84%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA_%D8%BA%D9%8A%D8%B1_%D8%A7%D9%84%D8%B9%D9%84%D8%A7%D8%A6%D9%82%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/NoSQL> ;
    skos:broader wtc:databases-2 ;
    skos:definition "صنف من أنظمة إدارة قواعد البيانات لا يتّبع كلّ قواعد قاعدة البيانات العلائقية، ويُستعمل كثيرًا لتخزين البيانات على نطاق واسع."@ar,
        "A class of database management systems that do not follow all the rules of a relational database; it is often used for large-scale data storage."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "NoSQL"@en ;
    wt:status "current" .

wtc:nuxt a skos:Concept ;
    rdfs:seeAlso <https://nuxt.com/> ;
    skos:broader wtc:meta-frameworks ;
    skos:definition "الإطار الفوقي المكافئ لـ Vue، ويضيف التوجيه وأنماط التصيير ومنظومة وحدات فوق نموذج مكوّنات Vue."@ar,
        "The equivalent meta-framework for Vue, adding routing, rendering modes and a module ecosystem on top of Vue's component model."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Nuxt"@en ;
    skos:related wtc:vue-js ;
    wt:status "current" .

wtc:orm a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Object-relational_mapping> ;
    skos:broader wtc:odoo-framework ;
    skos:definition "الربط بين الكائنات والعلاقات (ORM) تقنية برمجية تتيح للمطوّرين التعامل مع قاعدة بيانات علائقية بالنموذج كائنيّ التوجّه. تُربَط فيها الكائنات في لغة البرمجة بجداول قاعدة البيانات، وتُدار العلاقات بين الكائنات عبر ارتباطات في الشيفرة بدل استعلامات SQL المباشرة. ويساعد هذا على تبسيط التعامل مع قاعدة البيانات وتحسين قابلية صيانة الشيفرة والتجريد عن البنية الأساسية للقاعدة. ومن أشهر أطره Hibernate للغة Java وDjango ORM للغة Python وSequelize للغة Node.js."@ar,
        "ORM is a programming technique that allows developers to interact with a relational database using the object-oriented paradigm. In ORM, objects in a programming language are mapped to database tables, and relationships between objects are managed through associations in the code rather than direct SQL queries. ORMs help simplify database interactions, improve code maintainability, and provide abstraction from the underlying database structure. Popular ORM frameworks include Hibernate for Java, Django ORM for Python, and Sequelize for Node.js."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "ORM (Object-Relational Mapping)"@en ;
    skos:related wtc:oop,
        wtc:sql ;
    wt:status "current" .

wtc:owl a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Web_Ontology_Language>,
        <https://www.w3.org/OWL/> ;
    skos:broader wtc:linked-data ;
    skos:definition "لغة أنطولوجيا الويب (OWL) تُستعمل للتمثيل الصريح لمعاني المصطلحات في المفردات، وللعلاقات بين تلك المصطلحات."@ar,
        "Web Ontology Language (OWL) is used to explicitly represent the meaning of terms in vocabularies and the relationships between those terms."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "OWL"@en ;
    wt:status "current" .

wtc:owl-odoo-web-library a skos:Concept ;
    rdfs:seeAlso <https://www.odoo.com/documentation/15.0/developer/reference/addons/orm.html> ;
    skos:broader wtc:odoo-framework ;
    skos:definition "إطار المكوّنات الخاصّ بأودو، ويُستعمل لبناء واجهة عميل الويب. ولا ينبغي الخلط بينه وبين OWL بمعنى لغة أنطولوجيا الويب، وهي معيار من W3C للويب الدلالي يشاركه الاختصار ولا صلة بينهما."@ar,
        "Odoo's own component framework, used to build the web client interface. Not to be confused with OWL the Web Ontology Language, a W3C semantic web standard that shares the acronym but is unrelated."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "OWL (Odoo Web Library)"@en ;
    wt:status "current" .

wtc:pc-mobile a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AD%D8%A7%D8%B3%D9%88%D8%A8_%D8%B4%D8%AE%D8%B5%D9%8A>,
        <https://en.wikipedia.org/wiki/Mobile_device>,
        <https://en.wikipedia.org/wiki/Personal_computer> ;
    skos:broader wtc:devices ;
    skos:definition "الحواسيب الشخصية (PCs) والأجهزة المحمولة من هواتف ذكية وألواح رقمية هي أجهزة المستخدم النهائي التي يُتَّصل بها بالإنترنت وتُشغَّل عليها التطبيقات. توفّر الحواسيب الشخصية عادةً قدرة معالجة ومرونة أكبر، بينما توفّر الأجهزة المحمولة قابلية الحمل واليُسر."@ar,
        "Personal computers (PCs) and mobile devices (smartphones and tablets) are end-user devices used to access the internet and run applications. PCs typically offer more processing power and flexibility, while mobile devices provide portability and convenience."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "PC/Mobile"@en ;
    wt:status "current" .

wtc:php a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D9%8A_%D8%A5%D8%AA%D8%B4_%D8%A8%D9%8A>,
        <https://en.wikipedia.org/wiki/PHP>,
        <https://www.php.net/> ;
    skos:broader wtc:python-php ;
    skos:definition "لغة سكربتة من جانب الخادوم واسعة الانتشار، صُمِّمت لتطوير الويب وتُستعمل أيضًا لغةً برمجية عامّة الغرض."@ar,
        "A popular server-side scripting language designed for web development but also used as a general-purpose programming language."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "PHP"@en ;
    wt:status "current" .

wtc:pycharm a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/PyCharm>,
        <https://www.jetbrains.com/pycharm/> ;
    skos:broader wtc:ides ;
    skos:definition "بيئة التطوير PyCharm بيئة متكاملة مخصَّصة للغة بايثون طوّرتها JetBrains. وتوفّر أدوات أساسية للتطوير المنتج، منها تحليل الشيفرة ومنقّح رسومي ومختبِر وحدات مدمج والتكامل مع أنظمة التحكّم بالإصدارات."@ar,
        "PyCharm is a dedicated Python IDE developed by JetBrains. It provides essential tools for productive Python development, including code analysis, a graphical debugger, an integrated unit tester, and integration with version control systems."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "PyCharm"@en ;
    wt:status "current" .

wtc:python a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%A7%D9%8A%D8%AB%D9%88%D9%86_%28%D9%84%D8%BA%D8%A9_%D8%A8%D8%B1%D9%85%D8%AC%D8%A9%29>,
        <https://en.wikipedia.org/wiki/Python_(programming_language)>,
        <https://www.python.org/>,
        <https://youtu.be/EOLPQdVj5Ac?si=ZenEOd-cywwXkpIE> ;
    skos:broader wtc:python-php ;
    skos:definition "لغة برمجة عالية المستوى ومتعدّدة الاستعمالات، تُستخدَم على نطاق واسع في تطوير الويب وفي تطبيقات أخرى كثيرة."@ar,
        "A versatile, high-level programming language widely used for web development, among other applications."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Python"@en ;
    wt:status "current" .

wtc:quic a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%83%D9%88%D9%8A%D9%83_%28%D8%B4%D8%A8%D9%83%D8%A7%D8%AA%29>,
        <https://datatracker.ietf.org/doc/html/rfc9000>,
        <https://en.wikipedia.org/wiki/QUIC> ;
    skos:broader wtc:http-3 ;
    skos:definition "بروتوكول نقل مبنيّ على UDP يوفّر ما يوفّره TCP مع TLS من موثوقية وتحكّم في الازدحام وتشفير، لكن بمصافحة (handshake) أسرع ومجارٍ مستقلّة. وهو النقل الذي يقوم عليه HTTP/3."@ar,
        "A transport protocol built on UDP that provides the reliability, congestion control and encryption that TCP plus TLS provide, but with a faster handshake and independent streams. It is the transport underneath HTTP/3."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "QUIC"@en ;
    wt:status "current" .

wtc:remix a skos:Concept ;
    rdfs:seeAlso <https://remix.run/> ;
    skos:broader wtc:meta-frameworks ;
    skos:definition "إطار React مبنيّ حول أساسيات منصّة الويب — نماذج HTML وتخزين HTTP المؤقّت والتوجيه المتداخل — لا حول إدارة الحالة في العميل."@ar,
        "A React framework built around web platform fundamentals — HTML forms, HTTP caching and nested routing — rather than around client-side state management."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Remix"@en ;
    skos:related wtc:react-js ;
    wt:status "current" .

wtc:router a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D9%88%D8%AC%D9%87_%28%D8%B4%D8%A8%D9%83%D8%A7%D8%AA%29>,
        <https://en.wikipedia.org/wiki/Router_(computing)> ;
    skos:broader wtc:devices ;
    skos:definition "الموجّه جهاز شبكي يمرّر رزم البيانات بين شبكات الحاسوب، ويكون موصولًا عادةً بشبكتين على الأقلّ، كشبكة محلّية (LAN) وشبكة واسعة (WAN). وتحدّد الموجّهات أفضل مسار تسلكه البيانات من المصدر إلى الوجهة."@ar,
        "A router is a networking device that forwards data packets between computer networks, typically connected to at least two networks (e.g., LAN and WAN). Routers determine the best path for data to travel from source to destination."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Router"@en ;
    wt:status "current" .

wtc:saas a skos:Concept ;
    skos:broader wtc:cloud-computing ;
    skos:definition "برمجيات تُقدَّم عبر الإنترنت، عادةً باشتراك، مثل Google Workspace وSalesforce."@ar,
        "Software delivered via the internet, usually on a subscription basis (e.g., Google Workspace, Salesforce)."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "SaaS (Software as a Service)"@en ;
    wt:status "current" .

wtc:scss a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B3%D8%A7%D8%B3_%28%D9%84%D8%BA%D8%A9_%D8%AA%D9%86%D8%B3%D9%8A%D9%82_%D8%B5%D9%81%D8%AD%D8%A7%D8%AA_%D8%A7%D9%84%D9%88%D9%8A%D8%A8%29>,
        <https://en.wikipedia.org/wiki/Sass_(stylesheet_language)>,
        <https://sass-lang.com/> ;
    skos:broader wtc:css3 ;
    skos:definition "‏SCSS صياغة من صيغ SASS، وهي معالج أوّلي للـ CSS يوسّع قدراتها. يتيح للمطوّرين استعمال المتغيّرات والقواعد المتداخلة والمخاليط (mixins) والدوالّ، فتغدو CSS أيسر صيانةً وأقبل لإعادة الاستعمال وأسهل كتابةً. وهو متوافق تمامًا مع صياغة CSS الأصلية، ممّا يجعله وسيلة أقوى لتنظيم صفحات الأنماط وترشيدها في مشاريع تطوير الويب."@ar,
        "SCSS is a syntax of SASS (Syntactically Awesome Style Sheets), a CSS preprocessor that extends the capabilities of CSS. It allows developers to use variables, nested rules, mixins, and functions, making CSS more maintainable, reusable, and easier to write. SCSS is fully compatible with the original CSS syntax, making it a more powerful way to organize and streamline stylesheets in web development projects."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "SCSS (Sassy CSS)"@en ;
    wt:status "current" .

wtc:service-workers a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/API/Service_Worker_API>,
        <https://www.w3.org/TR/service-workers/> ;
    skos:broader wtc:progressive-web-apps ;
    skos:definition "نصّ برمجي يشغّله المتصفّح بمعزل عن الصفحة، وقادر على اعتراض طلباتها الشبكية. وهو الآلية التي تتيح لتطبيق الويب تقديم محتوى مخبَّأ دون اتّصال وتلقّي الإشعارات الفورية."@ar,
        "A script the browser runs separately from the page, able to intercept its network requests. This is the machinery that lets a web app serve cached content offline and receive push notifications."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Service Workers"@en ;
    skos:related wtc:caching ;
    wt:status "current" .

wtc:sparql a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B3%D8%A8%D8%A7%D8%B1%D9%83%D9%84>,
        <https://en.wikipedia.org/wiki/SPARQL>,
        <https://www.w3.org/TR/sparql11-overview/> ;
    skos:broader wtc:linked-data ;
    skos:definition "لغة استعلام لقواعد البيانات، قادرة على استرجاع البيانات المخزَّنة بصيغة RDF والتعامل معها."@ar,
        "A query language for databases, able to retrieve and manipulate data stored in RDF format."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "SPARQL"@en ;
    skos:related wtc:sql ;
    wt:status "current" .

wtc:sql-injection a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AD%D9%82%D9%86_%D8%A7%D9%84%D9%86%D8%B5%D9%88%D8%B5_%D8%A7%D9%84%D8%A8%D8%B1%D9%85%D8%AC%D9%8A%D8%A9_%D9%84%D9%84%D8%BA%D8%A9_%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%B9%D9%84%D8%A7%D9%85%D8%A7%D8%AA_%D8%A7%D9%84%D9%85%D9%87%D9%8A%D9%83%D9%84%D8%A9>,
        <https://en.wikipedia.org/wiki/SQL_injection> ;
    skos:broader wtc:threats ;
    skos:definition "تقنية حقن شيفرة تستغلّ ثغرات في تطبيقات الويب بإدراج استعلامات SQL خبيثة، ممّا يتيح للمهاجمين الوصول إلى بيانات قاعدة البيانات أو تعديلها أو حذفها."@ar,
        "A code injection technique that exploits vulnerabilities in web applications by inserting malicious SQL queries, allowing attackers to access, modify, or delete database data."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "SQL Injection"@en ;
    skos:related wtc:sql ;
    wt:status "current" .

wtc:sveltekit a skos:Concept ;
    rdfs:seeAlso <https://svelte.dev/docs/kit/introduction> ;
    skos:broader wtc:meta-frameworks ;
    skos:definition "إطار التطبيقات الرسمي لـ Svelte، يتولّى التوجيه وتحميل البيانات والاختيار بين التصيير على الخادوم والتصيير المسبق والتصيير في العميل، لكلّ مسار على حدة."@ar,
        "Svelte's official application framework, handling routing, data loading and the choice between server rendering, prerendering and client rendering per route."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "SvelteKit"@en ;
    skos:related wtc:svelte ;
    wt:status "current" .

wtc:switch a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%A8%D8%AF%D9%84_%28%D8%B4%D8%A8%D9%83%D8%A7%D8%AA%29>,
        <https://en.wikipedia.org/wiki/Network_switch> ;
    skos:broader wtc:devices ;
    skos:definition "المبدّل الشبكي جهاز يربط الأجهزة داخل الشبكة مستخدمًا تبديل الرزم (packet switching) لاستقبال البيانات ومعالجتها وتمريرها إلى الجهاز المقصود. وتعمل المبدّلات في طبقة ربط البيانات، أي الطبقة الثانية من نموذج OSI."@ar,
        "A network switch is a device that connects devices within a network by using packet switching to receive, process, and forward data to the destination device. Switches operate at the data link layer (Layer 2) of the OSI model."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Switch"@en ;
    wt:status "current" .

wtc:swrl-rif a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Rule_Interchange_Format>,
        <https://en.wikipedia.org/wiki/SPARQL>,
        <https://en.wikipedia.org/wiki/Semantic_Web_Rule_Language>,
        <https://www.w3.org/2005/rules/wiki/RIF_FAQ>,
        <https://www.w3.org/Submission/SWRL/>,
        <https://www.w3.org/TR/sparql11-overview/> ;
    skos:broader wtc:linked-data ;
    skos:definition "لغة قواعد الويب الدلالي (SWRL) وصيغة تبادل القواعد (RIF) معياران للتعبير عن القواعد على الويب. تتيح SWRL كتابة قواعد تُطبَّق على أنطولوجيات OWL، بينما تيسّر RIF تبادل القواعد بين الأنظمة المختلفة."@ar,
        "The Semantic Web Rule Language (SWRL) and Rule Interchange Format (RIF) are standards for expressing rules on the Web. SWRL allows users to write rules that can be applied to OWL ontologies, while RIF facilitates the interchange of rules among different systems."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "SWRL/RIF"@en ;
    wt:status "current" .

wtc:symbolic-ai a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B0%D9%83%D8%A7%D8%A1_%D8%A7%D8%B5%D8%B7%D9%86%D8%A7%D8%B9%D9%8A_%D8%B1%D9%85%D8%B2%D9%8A>,
        <https://en.wikipedia.org/wiki/Symbolic_artificial_intelligence> ;
    skos:broader wtc:ai ;
    skos:definition "الذكاء الاصطناعي الرمزي يستعمل قواعد ومنطقًا صريحًا مقروءًا للإنسان لأداء مهامّ الاستدلال. ويعتمد على تمثيلات رمزية للمعرفة وعلى الاستنتاج المنطقي لمحاكاة السلوك الذكي، وهو ما نراه عادةً في النظم الخبيرة."@ar,
        "Symbolic AI uses explicit, human-readable rules and logic to perform reasoning tasks. It relies on symbolic representations of knowledge and logical inference to simulate intelligent behavior, commonly seen in expert systems."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Symbolic AI"@en ;
    wt:status "current" .

wtc:tailwind-css a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D9%84%D9%88%D9%86%D8%AF_%D8%B3%D9%8A_%D8%A5%D8%B3_%D8%A5%D8%B3>,
        <https://en.wikipedia.org/wiki/Tailwind_CSS>,
        <https://tailwindcss.com/> ;
    skos:broader wtc:css3 ;
    skos:definition "إطار CSS يقوم على المنفعة أوّلًا: بدل كتابة صفحات أنماط مخصَّصة، تركّب أصنافًا صغيرة أحادية الغرض داخل الترميز مباشرةً. وهو يسلك المسلك المعاكس لأطر المكوّنات مثل Bootstrap، فيقايض وضوح HTML بإزالة مشكلتَي التسمية وCSS الميّتة، وهما مشكلتان تكبران مع كلّ صفحة أنماط مكتوبة يدويًّا."@ar,
        "A utility-first CSS framework: instead of writing custom stylesheets, you compose small single-purpose classes directly in the markup. It takes the opposite approach to component frameworks like Bootstrap, trading readable HTML for the removal of the naming and dead-CSS problems that grow with a hand-written stylesheet."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Tailwind CSS"@en ;
    skos:related wtc:bootstrap ;
    wt:status "current" .

wtc:tls-https a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%88%D8%AA%D9%88%D9%83%D9%88%D9%84_%D8%B7%D8%A8%D9%82%D8%A9_%D8%A7%D9%84%D9%85%D9%82%D8%A7%D8%A8%D8%B3_%D8%A7%D9%84%D8%A2%D9%85%D9%86%D8%A9>,
        <https://datatracker.ietf.org/doc/html/rfc8446>,
        <https://en.wikipedia.org/wiki/Transport_Layer_Security> ;
    skos:broader wtc:defenses ;
    skos:definition "أمن طبقة النقل (TLS) يشفّر الاتّصال بين المتصفّح والخادوم ويوثّقه، فلا يمكن قراءة حركة البيانات أو تغييرها أثناء العبور. وHTTPS هو HTTP محمولًا فوق TLS، وقد صار اليوم شرطًا لمعظم خصائص المتصفّح."@ar,
        "Transport Layer Security encrypts and authenticates the connection between browser and server, so traffic cannot be read or altered in transit. HTTPS is HTTP carried over TLS, and is now a prerequisite for most browser features."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "TLS / HTTPS"@en ;
    skos:related wtc:http-https ;
    wt:status "current" .

wtc:utf-16 a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%8A%D9%88_%D8%AA%D9%8A_%D8%A7%D9%81-16>,
        <https://en.wikipedia.org/wiki/UTF-16> ;
    skos:broader wtc:unicode ;
    skos:definition "صيغة تحويل يونيكود بستّة عشر بتًا (UTF-16) ترميز آخر لمحارف يونيكود، يستعمل وحدة ترميز واحدة أو وحدتين بطول ستّة عشر بتًا لترميز المحرف. ورغم أنّه أكفأ في ترميز المحارف خارج المستوى متعدّد اللغات الأساسي (BMP)، فإنّه أقلّ استعمالًا من UTF-8 في محتوى الويب."@ar,
        "UTF-16 (Unicode Transformation Format - 16-bit) is another character encoding used to encode Unicode characters. It uses either one or two 16-bit code units to encode characters. While UTF-16 is more efficient for encoding characters beyond the Basic Multilingual Plane (BMP), it is less commonly used than UTF-8 for web content."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "UTF-16"@en ;
    wt:status "current" .

wtc:utf-8 a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B5%D9%8A%D8%BA%D8%A9_%D8%A7%D9%84%D8%AA%D8%AD%D9%88%D9%8A%D9%84_%D8%A7%D9%84%D9%85%D9%88%D8%AD%D8%AF-8>,
        <https://en.wikipedia.org/wiki/UTF-8> ;
    skos:broader wtc:unicode ;
    skos:definition "صيغة تحويل يونيكود بثمانية بتات (UTF-8) ترميز محارف متغيّر العرض يُستعمل في الاتّصال الإلكتروني. ويستطيع ترميز كلّ المحارف الممكنة، أي نقاط الترميز في يونيكود، باستعمال بايت واحد إلى أربعة. وهو متوافق رجعيًّا مع ASCII وواسع الانتشار على الويب لتمثيل النصّ، لكفاءته في ترميز المحارف الشائعة وتوافقه عبر الأنظمة المختلفة."@ar,
        "UTF-8 (Unicode Transformation Format - 8-bit) is a variable-width character encoding used for electronic communication. It can encode all possible characters (code points) in Unicode using one to four bytes. UTF-8 is backward-compatible with ASCII and is widely used on the web for text representation due to its efficiency in encoding common characters and its compatibility across different systems."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "UTF-8"@en ;
    wt:status "current" .

wtc:vs-code a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%81%D9%8A%D8%AC%D9%88%D8%A7%D9%84_%D8%B3%D8%AA%D9%88%D8%AF%D9%8A%D9%88_%D9%83%D9%88%D8%AF>,
        <https://code.visualstudio.com/>,
        <https://en.wikipedia.org/wiki/Visual_Studio_Code> ;
    skos:broader wtc:ides ;
    skos:definition "محرّر الشيفرة VS Code محرّر مجّاني مفتوح المصدر طوّرته مايكروسوفت. ويدعم التنقيح، والتحكّم بالإصدارات عبر Git مدمجًا، وتلوين الصياغة، والإكمال الذكيّ للشيفرة، والمقتطفات، وإعادة هيكلة الشيفرة."@ar,
        "Visual Studio Code (VS Code) is a free, open-source code editor developed by Microsoft. It offers support for debugging, embedded Git control, syntax highlighting, intelligent code completion, snippets, and code refactoring."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "VS Code"@en ;
    wt:status "current" .

wtc:webauthn-passkeys a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%8A%D8%A8_%D8%A3%D9%88%D8%AB%D9%86>,
        <https://en.wikipedia.org/wiki/WebAuthn>,
        <https://passkeys.dev/>,
        <https://www.w3.org/TR/webauthn-2/> ;
    skos:broader wtc:defenses ;
    skos:definition "معيار لتسجيل الدخول بتعمية المفتاح العامّ بدل سرّ مشترك. لا يغادر المفتاح الخاصّ جهاز المستخدم قطّ، فلا توجد كلمة سرّ يسرّبها موقع أو يصطادها مهاجم. ومفاتيح المرور (Passkeys) اعتمادات WebAuthn متزامنة عبر أجهزة المستخدم."@ar,
        "A standard for signing in with public-key cryptography instead of a shared secret. The private key never leaves the user's device, so there is no password for a site to leak or an attacker to phish. Passkeys are WebAuthn credentials synchronised across a user's devices."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "WebAuthn and Passkeys"@en ;
    skos:related wtc:phishing ;
    wt:status "current" .

wtc:xpath a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A5%D9%83%D8%B3%D8%A8%D8%A7%D8%AB>,
        <https://en.wikipedia.org/wiki/XPath>,
        <https://www.w3.org/TR/xpath-31/> ;
    skos:broader wtc:xml ;
    skos:definition "لغة مسارات XML، أي (XPath)، لغة استعلام لانتقاء العقد من مستند XML. وتوفّر وسيلة للتنقّل بين العناصر والسمات داخل المستند بصياغة شبيهة بالمسارات. وتُستعمل على نطاق واسع مع XSLT وXQuery وسائر تقنيات XML لاسترجاع أجزاء محدَّدة من البيانات."@ar,
        "XPath is a query language for selecting nodes from an XML document. It provides a way to navigate through elements and attributes in an XML document using a path-like syntax. XPath is widely used in conjunction with XSLT, XQuery, and other XML technologies to retrieve specific parts of XML data."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "XPath (XML Path Language)"@en ;
    wt:status "current" .

wtc:algorithmic a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AE%D9%88%D8%A7%D8%B1%D8%B2%D9%85%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Algorithm> ;
    skos:definition "دراسة الخوارزميات وتطويرها، وهي محور حلّ المسائل الحاسوبية وتحسين الأداء في البرمجة والأنظمة."@ar,
        "The study and development of algorithms, which are central to solving computational problems and optimizing performance in programming and systems."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Algorithmic"@en ;
    skos:related wtc:algorithms ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:angularjs a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A3%D9%86%D8%AC%D9%88%D9%84%D8%A7%D8%B1_%D8%AC%D9%8A_%D8%A5%D8%B3>,
        <https://en.wikipedia.org/wiki/AngularJS> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "إطار العمل الأصلي بلغة جافاسكريبت الذي أطلقته غوغل سنة 2010، وقد خلفه Angular المذكور أعلاه ولم يعد مصونًا منذ جانفي 2022. وهو مُدرَج هنا لأنّ كمًّا كبيرًا من المواد التعليمية القديمة ما زال يشير إليه؛ ولاحظ أنّ AngularJS وAngular إطاران متمايزان وغير متوافقين."@ar,
        "The original JavaScript framework released by Google in 2010, superseded by Angular (above) and no longer maintained since January 2022. It is listed here because a large amount of older tutorial material still refers to it; note that AngularJS and Angular are distinct frameworks and are not compatible."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "AngularJS"@en ;
    wt:status "legacy" .

wtc:artificial-intelligence a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B0%D9%83%D8%A7%D8%A1_%D8%A7%D8%B5%D8%B7%D9%86%D8%A7%D8%B9%D9%8A>,
        <https://en.wikipedia.org/wiki/Artificial_intelligence> ;
    skos:definition "فرع علوم الحاسوب المعنيّ بإنشاء أنظمة تحاكي الذكاء البشري، ويشمل تعلُّم الآلة ومعالجة اللغات الطبيعية والروبوتات."@ar,
        "The branch of computer science focused on creating systems that mimic human intelligence, including machine learning, natural language processing, and robotics."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Artificial Intelligence"@en ;
    skos:related wtc:ai,
        wtc:machine-learning ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:astro a skos:Concept ;
    rdfs:seeAlso <https://astro.build/> ;
    skos:broader wtc:meta-frameworks ;
    skos:definition "إطار موجَّه إلى المواقع كثيفة المحتوى. لا يرسل أيّ جافاسكريبت افتراضيًّا، ولا يُرطِّب إلّا المكوّنات التي تحدّدها تفاعلية، ويستطيع مزج مكوّنات React وVue وSvelte في مشروع واحد."@ar,
        "A framework aimed at content-heavy sites. It ships zero JavaScript by default and hydrates only the components you mark as interactive, and it can mix React, Vue and Svelte components in one project."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Astro"@en ;
    skos:related wtc:hydration,
        wtc:jamstack ;
    wt:status "current" .

wtc:autonomous-systems a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Autonomous_system> ;
    skos:broader wtc:statistical-ai ;
    skos:definition "الأنظمة ذاتية التشغيل آلات أو برمجيات تستطيع أداء المهامّ باستقلالية دون تدخّل بشري، مستعملةً الذكاء الاصطناعي وتعلُّم الآلة لاتّخاذ القرار آنيًّا. ومن أمثلتها الروبوتات والسيارات ذاتية القيادة وأنظمة خدمة العملاء الآلية."@ar,
        "Autonomous systems are machines or software that can perform tasks independently without human intervention, using AI and machine learning to make real-time decisions. Examples include robots, self-driving cars and automated customer service systems."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Autonomous Systems"@en ;
    wt:status "current" .

wtc:basic-html a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%84%D8%BA%D8%A9_%D8%AA%D8%A3%D8%B4%D9%8A%D8%B1_%D8%A7%D9%84%D9%86%D8%B5_%D8%A7%D9%84%D8%AA%D8%B1%D8%A7%D8%A8%D8%B7%D9%8A>,
        <https://en.wikipedia.org/wiki/HTML>,
        <https://www.w3.org/TR/html401/> ;
    skos:definition "لغة الترميز الأساسية التي كانت تُستعمل لإنشاء صفحات ويب ساكنة في أيّام الإنترنت الأولى."@ar,
        "The foundational markup language used for creating static web pages during the early days of the internet."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Basic HTML"@en ;
    skos:related wtc:html5 ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:bootstrap a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D9%88%D8%AA%D8%B3%D8%AA%D8%B1%D8%A7%D8%A8>,
        <https://en.wikipedia.org/wiki/Bootstrap_(front-end_framework)>,
        <https://getbootstrap.com/> ;
    skos:broader wtc:css3 ;
    skos:definition "‏Bootstrap إطار عمل واجهة أمامية مفتوح المصدر وواسع الانتشار، يُستعمل لتطوير مواقع متجاوبة تُصمَّم للمحمول أوّلًا. ويوفّر مجموعة من مكوّنات HTML وCSS وJavaScript تبسّط بناء الصفحات بتخطيط وتصميم متّسقين. ويضمّ مكوّنات جاهزة كأشرطة التنقّل والأزرار والنماذج والشبكات، تتيح للمطوّرين بناء واجهات جذّابة وعملية بسرعة عبر مقاسات الأجهزة المختلفة."@ar,
        "Bootstrap is a popular open-source front-end framework used for developing responsive and mobile-first websites. It provides a collection of HTML, CSS, and JavaScript components that simplify the development of web pages with a consistent layout and design. Bootstrap includes pre-designed components like navigation bars, buttons, forms, and grids, which allow developers to quickly build visually appealing and functional interfaces across different device sizes."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Bootstrap"@en ;
    wt:status "current" .

wtc:computer-architecture a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%B9%D9%85%D8%A7%D8%B1%D9%8A%D8%A9_%D8%A7%D9%84%D8%AD%D8%A7%D8%B3%D9%88%D8%A8>,
        <https://en.wikipedia.org/wiki/Computer_architecture> ;
    skos:definition "تصميم أنظمة الحاسوب وتنظيمها، بما فيها المعالجات والذاكرة وأجهزة الإدخال والإخراج، بما يضمن تنفيذ التعليمات بكفاءة."@ar,
        "The design and organization of computer systems, including processors, memory, and input/output devices, ensuring efficient execution of instructions."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Computer Architecture"@en ;
    skos:related wtc:server,
        wtc:webassembly ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:cyber-security a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A3%D9%85%D9%86_%D8%A7%D9%84%D8%AD%D8%A7%D8%B3%D9%88%D8%A8>,
        <https://en.wikipedia.org/wiki/Computer_security> ;
    skos:definition "ممارسة حماية الحواسيب والشبكات والبيانات من التهديدات السيبرانية (cyber threats)، بما في ذلك الوصول غير المصرَّح به والهجمات وخروقات البيانات (data breaches)."@ar,
        "The practice of protecting computers, networks, and data from cyber threats, including unauthorized access, attacks, and data breaches."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Cyber Security"@en ;
    skos:related wtc:defenses,
        wtc:threats ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:data a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Data> ;
    skos:definition "البيانات معلومات تعالجها أنظمة الحوسبة وتخزّنها وتنقلها. وقد تكون مهيكلة كقواعد البيانات، أو شبه مهيكلة مثل XML وJSON وRDF، أو غير مهيكلة كالمحتوى المتعدّد الوسائط، وهي جوهر كلّ نظام رقمي."@ar,
        "Data is information that is processed, stored, and transmitted by computing systems. It can be structured (e.g., databases), semi-structured (e.g., XML, Json, RDF) or unstructured (e.g., multimedia content), and is the core of all digital systems."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Data"@en ;
    skos:related wtc:data-encoding,
        wtc:data-exchange-formats,
        wtc:databases-2 ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:databases a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%82%D8%A7%D8%B9%D8%AF%D8%A9_%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Database> ;
    skos:definition "دراسة قواعد البيانات وإدارتها، بما يشمل تصميم الأنظمة التي تخزّن كمّيات كبيرة من البيانات وتنظّمها، وتحسينها، والاستعلام عنها."@ar,
        "The study and management of databases, including the design, optimization, and querying of systems that store and organize large amounts of data."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Databases"@en ;
    skos:related wtc:databases-2,
        wtc:sql ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:disciplines a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B9%D9%84%D9%85_%D8%A7%D9%84%D8%AD%D8%A7%D8%B3%D9%88%D8%A8>,
        <https://en.wikipedia.org/wiki/Computer_science> ;
    skos:definition "التخصّصات حقول دراسية متخصّصة داخل علوم الحاسوب والهندسة، توجّه البحث والتطوير في مجالات بعينها، كالذكاء الاصطناعي والأمن السيبراني والشبكات."@ar,
        "Disciplines are specialized fields of study within computer science and engineering that guide research and development in specific areas, such as AI, cybersecurity, and networking."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Disciplines"@en ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:django a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AC%D8%A7%D9%86%D8%BA%D9%88_%28%D8%A5%D8%B7%D8%A7%D8%B1_%D8%B9%D9%85%D9%84_%D9%88%D9%8A%D8%A8%29>,
        <https://drive.google.com/drive/folders/1tvsKwBmeNwwegdx5YJQGvzZnEK-GKZnx>,
        <https://en.wikipedia.org/wiki/Django_(web_framework)>,
        <https://www.djangoproject.com/>,
        <https://youtu.be/w8q0C-C1js4?si=fFhDvSuZkNwZK5IO> ;
    skos:broader wtc:web-frameworks ;
    skos:definition "إطار عمل ويب عالي المستوى بلغة بايثون، يشجّع على التطوير السريع والتصميم النظيف العمليّ."@ar,
        "A high-level Python web framework that encourages rapid development and clean, pragmatic design."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Django"@en ;
    wt:status "current" .

wtc:dynamic-and-interactive-web a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%8A%D8%A8_2.0>,
        <https://en.wikipedia.org/wiki/Web_2.0> ;
    skos:definition "أدخلت الويب 2.0 تفاعل المستخدم والمحتوى الديناميكي، متجاوزةً الصفحات الساكنة إلى مواقع أكثر إشراكًا للزائر."@ar,
        "Web 2.0 introduced user interaction and dynamic content, moving beyond static pages to more engaging websites."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Dynamic and Interactive Web"@en ;
    skos:related wtc:javascript,
        wtc:spas ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:e-mail a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%8A%D8%AF_%D8%A5%D9%84%D9%83%D8%AA%D8%B1%D9%88%D9%86%D9%8A>,
        <https://en.wikipedia.org/wiki/Email> ;
    skos:definition "نظام بريد إلكتروني صار من أوائل استعمالات الإنترنت. يتيح للمستخدمين إرسال الرسائل والملفّات واستقبالها إلكترونيًّا عبر شبكة."@ar,
        "An electronic mail system that became one of the first uses of the Internet. It allows users to send and receive messages and files electronically over a network."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "E-mail"@en ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:erp-systems a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%AE%D8%B7%D9%8A%D8%B7_%D9%85%D9%88%D8%A7%D8%B1%D8%AF_%D8%A7%D9%84%D9%85%D8%A4%D8%B3%D8%B3%D8%A9>,
        <https://en.wikipedia.org/wiki/Enterprise_resource_planning> ;
    skos:broader wtc:odoo-framework ;
    skos:definition "أنظمة تخطيط موارد المؤسّسة (ERP) أنظمة إدارة متكاملة تتيح للمنظّمات إدارة عمليات الأعمال في نظام مركزي واحد."@ar,
        "Enterprise Resource Planning (ERP) systems are integrated management systems that allow organizations to manage business processes in a centralized system."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "ERP Systems"@en ;
    wt:status "current" .

wtc:es6-features a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/ECMAScript>,
        <https://www.ecma-international.org/publications-and-standards/standards/ecma-262/> ;
    skos:broader wtc:javascript ;
    skos:definition "جاءت النسخة السادسة من إيكماسكريبت (ES6) وما تلاها بتحسينات جوهرية على جافاسكريبت، شملت صياغة وخصائص جديدة."@ar,
        "ECMAScript 6 (ES6) and later editions brought significant improvements to JavaScript, including new syntax and features."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "ES6+ features"@en ;
    wt:status "current" .

wtc:esbuild a skos:Concept ;
    rdfs:seeAlso <https://esbuild.github.io/> ;
    skos:broader wtc:build-tooling ;
    skos:definition "مُحزِّم لجافاسكريبت وTypeScript مكتوب بلغة Go، أسرع بمرتبة أو مرتبتين من المُحزِّمات السابقة المكتوبة بجافاسكريبت. وتستعمله أدوات أخرى عدّة داخليًّا بدل إعادة تنفيذ العمل نفسه."@ar,
        "A JavaScript and TypeScript bundler written in Go, one to two orders of magnitude faster than the earlier JavaScript-based bundlers. Several other tools use it internally rather than reimplementing the work."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "esbuild"@en ;
    wt:status "current" .

wtc:flask a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%81%D9%84%D8%A7%D8%B3%D9%83_%28%D8%A5%D8%B7%D8%A7%D8%B1_%D8%B9%D9%85%D9%84_%D9%88%D9%8A%D8%A8%29>,
        <https://drive.google.com/drive/folders/1ZGhmS15qIsTIGGgA5kFigI7AawwHx3Ga>,
        <https://en.wikipedia.org/wiki/Flask_(web_framework)>,
        <https://flask.palletsprojects.com/> ;
    skos:broader wtc:web-frameworks ;
    skos:definition "إطار عمل خفيف لتطبيقات الويب بلغة بايثون يعتمد معيار WSGI. صُمِّم ليجعل الانطلاق سريعًا وسهلًا، مع القدرة على التوسّع إلى تطبيقات معقّدة."@ar,
        "A lightweight WSGI web application framework in Python. It is designed to make getting started quick and easy, with the ability to scale up to complex applications."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Flask"@en ;
    wt:status "current" .

wtc:frameworks a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A5%D8%B7%D8%A7%D8%B1_%D8%B9%D9%85%D9%84_%28%D8%A8%D8%B1%D9%85%D8%AC%D8%A9%29>,
        <https://en.wikipedia.org/wiki/Software_framework> ;
    skos:definition "أطر العمل مجموعات من الشيفرة الجاهزة توفّر أساسًا لبناء التطبيقات. وهي تختصر التطوير بتقديم مكوّنات وأنماط قابلة لإعادة الاستعمال، مثل Odoo وDjango وFlask."@ar,
        "Frameworks are collections of pre-written code that provide a foundation for building applications. They streamline development by offering reusable components and patterns, such as Odoo, Django, and Flask."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Frameworks"@en ;
    skos:related wtc:frameworks-and-libraries,
        wtc:web-frameworks ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:github a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%BA%D9%8A%D8%AA_%D9%87%D8%A7%D8%A8>,
        <https://en.wikipedia.org/wiki/GitHub>,
        <https://github.com/> ;
    skos:definition "منصّة لاستضافة الشيفرة تتيح التحكّم بالإصدارات والتعاون، فيدير المطوّرون شيفرتهم ويخزّنونها باستعمال Git."@ar,
        "A code hosting platform for version control and collaboration, allowing developers to manage and store their code using Git."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "GitHub"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:graph-databases a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Graph_database> ;
    skos:broader wtc:databases-2 ;
    skos:definition "قاعدة البيانات الرسمية نوع من قواعد NoSQL يستعمل بُنى الرسوم من عقد وحوافّ وخصائص لتمثيل البيانات وتخزينها. وهي محسَّنة للتعامل مع البيانات ذات العلاقات المعقّدة، ومفيدة بوجه خاصّ في تطبيقات كالشبكات الاجتماعية ومحرّكات التوصية وكشف الاحتيال. تمثّل العقد الكيانات، وتمثّل الحوافّ العلاقات بينها، ممّا يجعل الاستعلام عن البيانات المترابطة المعقّدة والتنقّل فيها أمرًا كفؤًا."@ar,
        "A graph database is a type of NoSQL database that uses graph structures with nodes, edges, and properties to represent and store data. It is optimized for handling data with complex relationships and is particularly useful in applications like social networks, recommendation engines, and fraud detection. Nodes represent entities, while edges represent the relationships between those entities, making querying and navigating complex interconnected data efficient."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Graph Databases"@en ;
    wt:status "current" .

wtc:http-3 a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/HTTP/3>,
        <https://httpwg.org/specs/rfc9114.html> ;
    skos:broader wtc:http-https ;
    skos:definition "الإصدار الرئيس الحالي من HTTP، ويُحمَل فوق QUIC بدل TCP. ولأنّ كلّ مجرى (stream) مستقلّ، لم تعد رزمة واحدة ضائعة توقف بقية الطلبات على الاتّصال، وهو ما يهمّ أكثر ما يهمّ على الشبكات المحمولة وكثيرة الفقد."@ar,
        "The current major version of HTTP, carried over QUIC instead of TCP. Because each stream is independent, a single lost packet no longer stalls every other request on the connection, which matters most on mobile and lossy networks."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "HTTP/3"@en ;
    wt:status "current" .

wtc:humans a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D9%81%D8%A7%D8%B9%D9%84_%D8%A7%D9%84%D8%A5%D9%86%D8%B3%D8%A7%D9%86_%D9%85%D8%B9_%D8%A7%D9%84%D8%AD%D8%A7%D8%B3%D9%88%D8%A8>,
        <https://en.wikipedia.org/wiki/Human%E2%80%93computer_interaction> ;
    skos:definition "البشر هم المستخدمون النهائيون للتقنية وصانعوها. ويُعنى تفاعل الإنسان والحاسوب (HCI) بتصميم أنظمة ميسورة الوصول وسهلة الاستعمال وفعّالة في الاستخدام البشري."@ar,
        "Humans are the end-users and creators of technology. Human-Computer Interaction (HCI) focuses on designing systems that are accessible, user-friendly, and effective for human use."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Humans"@en ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:ieee a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%B9%D9%87%D8%AF_%D9%85%D9%87%D9%86%D8%AF%D8%B3%D9%8A_%D8%A7%D9%84%D9%83%D9%87%D8%B1%D8%A8%D8%A7%D8%A1_%D9%88%D8%A7%D9%84%D8%A5%D9%84%D9%83%D8%AA%D8%B1%D9%88%D9%86%D9%8A%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Institute_of_Electrical_and_Electronics_Engineers>,
        <https://www.ieee.org/> ;
    skos:definition "معهد مهندسي الكهرباء والإلكترونيات (IEEE) أكبر منظّمة مهنية تقنية في العالم، وهو معنيّ بالنهوض بالتقنية. ويُعرَف على نطاق واسع بوضعه معايير في مجالات متنوّعة كالحوسبة والشبكات والإلكترونيات. وتساعد معاييره على ضمان قابلية التشغيل البيني والابتكار والجودة عبر تقنيات عديدة."@ar,
        "IEEE is the world's largest technical professional organization focused on advancing technology. It is widely recognized for creating standards in a variety of areas such as computing, networking, and electronics. IEEE standards help ensure interoperability, innovation, and quality across numerous technologies."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "IEEE (Institute of Electrical and Electronics Engineers)"@en ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:information-systems a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D8%B8%D9%85_%D9%85%D8%B9%D9%84%D9%88%D9%85%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Information_system> ;
    skos:definition "تكامل تقنية المعلومات مع عمليات الأعمال لإدارة البيانات واستخدامها بفعالية داخل المنظّمات، لأغراض اتّخاذ القرار وتسيير العمليات."@ar,
        "The integration of information technology and business processes to manage and use data effectively in organizations for decision-making and operations."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Information Systems"@en ;
    skos:related wtc:erp-systems,
        wtc:odoo-framework ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:interfaces a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D8%A7%D8%AC%D9%87%D8%A9_%D9%85%D8%B3%D8%AA%D8%AE%D8%AF%D9%85_%D8%B1%D8%B3%D9%88%D9%85%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/API>,
        <https://en.wikipedia.org/wiki/Graphical_user_interface> ;
    skos:definition "الواجهات هي نقاط التفاعل بين المستخدمين والأنظمة، أو بين الأنظمة بعضها مع بعض. وتشمل اللغات وواجهات المستخدم الرسومية (GUIs) وواجهات برمجة التطبيقات (APIs)."@ar,
        "Interfaces are the points of interaction between users and systems or between different systems themselves. This includes languages, graphical user interfaces (GUIs) and application programming interfaces (APIs)."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Interfaces"@en ;
    skos:related wtc:graphql,
        wtc:restful-apis ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:iot-ioe-integration a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A5%D9%86%D8%AA%D8%B1%D9%86%D8%AA_%D8%A7%D9%84%D8%A3%D8%B4%D9%8A%D8%A7%D8%A1>,
        <https://en.wikipedia.org/wiki/Internet_of_everything>,
        <https://en.wikipedia.org/wiki/Internet_of_things> ;
    skos:definition "يشير إنترنت الأشياء (IoT) إلى شبكة الأجسام المادّية المزوّدة بالمستشعرات والبرمجيات والاتّصال، بما يتيح لها جمع البيانات وتبادلها. ويوسّع إنترنت كلّ شيء (IoE) هذا المفهوم ليشمل الأشخاص والعمليات والبيانات أيضًا. وتُدمَج هاتان التقنيتان في تطبيقات الويب لتعزيز الأتمتة والرؤى المستندة إلى البيانات والترابط بين الأجهزة الذكية."@ar,
        "IoT refers to the network of physical objects embedded with sensors, software, and connectivity that allows them to collect and exchange data. IoE expands this concept to include people, processes, and data as well. These technologies are integrated into web applications to enhance automation, data-driven insights, and interconnectivity between smart devices."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "IoT/IoE Integration (Internet of Things/Internet of Everything)"@en ;
    skos:related wtc:devices ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:iso a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A7%D9%84%D9%85%D9%86%D8%B8%D9%85%D8%A9_%D8%A7%D9%84%D8%AF%D9%88%D9%84%D9%8A%D8%A9_%D9%84%D9%84%D9%85%D8%B9%D8%A7%D9%8A%D9%8A%D8%B1>,
        <https://en.wikipedia.org/wiki/International_Organization_for_Standardization>,
        <https://www.iso.org/> ;
    skos:definition "المنظّمة الدولية للتقييس (ISO) منظّمة دولية مستقلّة غير حكومية تطوّر وتنشر طيفًا واسعًا من المعايير عبر مختلف القطاعات. وتضمن هذه المعايير الجودة والسلامة والكفاءة وقابلية التشغيل البيني للمنتجات والأنظمة والخدمات. ولمعاييرها أهمّية بالغة في مجالات كالتقنية وتطوير الويب وإدارة البيانات."@ar,
        "ISO is an independent, non-governmental international organization that develops and publishes a wide range of standards across various industries. These standards ensure quality, safety, efficiency, and interoperability for products, systems, and services. ISO standards are crucial in areas like technology, web development, and data management."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "ISO (International Organization for Standardization)"@en ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:languages a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%84%D8%BA%D8%A9_%D8%A8%D8%B1%D9%85%D8%AC%D8%A9>,
        <https://en.wikipedia.org/wiki/Programming_language> ;
    skos:definition "لغات البرمجة لغات صورية تُستخدَم لتوجيه الآلات إلى كيفية أداء المهامّ. ومن أشهرها Python وPHP وC++ وJavaScript."@ar,
        "Programming languages are formal languages used to instruct machines on how to perform tasks. Popular languages include Python, PHP, C++, and JavaScript."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Languages"@en ;
    skos:related wtc:javascript,
        wtc:programming ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:machine-learning a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%B9%D9%84%D9%85_%D8%A7%D9%84%D8%A2%D9%84%D8%A9>,
        <https://en.wikipedia.org/wiki/Machine_learning> ;
    skos:broader wtc:supervised-unsupervised-learning ;
    skos:definition "تعلُّم الآلة فرع من الذكاء الاصطناعي (AI) يقوم على تدريب النماذج على التعرّف إلى الأنماط في البيانات وإصدار تنبّؤات أو قرارات بناءً عليها. وهو يمكّن الأنظمة من التعلّم بالتجربة والتحسّن مع الوقت دون برمجتها صراحةً."@ar,
        "Machine learning is a subset of AI that involves training models to recognize patterns in data and make predictions or decisions based on that data. It enables systems to learn from experience and improve over time without being explicitly programmed."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Machine Learning (ML)"@en ;
    wt:status "current" .

wtc:machines a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A2%D9%84%D8%A9>,
        <https://en.wikipedia.org/wiki/Machine> ;
    skos:definition "الآلات هي أجهزة الحوسبة، وتشمل الخواديم والحواسيب الشخصية والأجهزة المحمولة وأجهزة الشبكات وأجهزة إنترنت الأشياء (IoT)، وهي تعالج البيانات وتنفّذ التعليمات وتؤدّي المهامّ الآلية."@ar,
        "Machines refer to computing devices, including servers, personal computers, mobile and networking devices, and IoT devices, that process data, execute instructions, and perform automated tasks."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Machines"@en ;
    skos:related wtc:devices ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:minification a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Minification_(programming)> ;
    skos:definition "عملية إزالة المحارف غير الضرورية من الشيفرة لتقليل حجمها، ممّا يحسّن أزمنة التحميل والأداء."@ar,
        "The process of removing unnecessary characters from code to reduce its size, improving load times and performance."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Minification"@en ;
    skos:related wtc:esbuild,
        wtc:vite ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:networking a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B4%D8%A8%D9%83%D8%A9_%D8%AD%D8%A7%D8%B3%D9%88%D8%A8>,
        <https://en.wikipedia.org/wiki/Computer_network> ;
    skos:definition "الحقل المعنيّ بتصميم الاتّصال بين الحواسيب والأجهزة عبر الشبكات وتنفيذه وإدارته، بما في ذلك الإنترنت."@ar,
        "The field focused on the design, implementation, and management of communication between computers and devices over networks, including the internet."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Networking"@en ;
    skos:related wtc:networking-2,
        wtc:tcp-ip ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:nlp a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%B9%D8%A7%D9%84%D8%AC%D8%A9_%D8%A7%D9%84%D9%84%D8%BA%D8%A9_%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%B9%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Natural_language_processing> ;
    skos:broader wtc:nlp-nlu-and-nlg ;
    skos:definition "معالجة اللغات الطبيعية (NLP) حقل من الذكاء الاصطناعي معنيّ بالتفاعل بين الحواسيب والبشر عبر اللغة الطبيعية. ويشمل معالجة كمّيات كبيرة من بيانات اللغة الطبيعية وتحليلها."@ar,
        "NLP is the field of AI focused on the interaction between computers and humans through natural language. It involves processing and analyzing large amounts of natural language data."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "NLP"@en ;
    wt:status "current" .

wtc:operating-systems a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D8%B8%D8%A7%D9%85_%D8%AA%D8%B4%D8%BA%D9%8A%D9%84>,
        <https://en.wikipedia.org/wiki/Operating_system> ;
    skos:definition "إدارة موارد العتاد والبرمجيات في الحاسوب. تتحكّم أنظمة التشغيل في تنفيذ التطبيقات، وتدير الذاكرة، وتوفّر الخدمات الأساسية."@ar,
        "The management of hardware and software resources on a computer. Operating systems control the execution of applications, manage memory, and provide essential services."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Operating Systems"@en ;
    skos:related wtc:docker,
        wtc:virtualization ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:organizations a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D9%86%D8%B8%D9%85%D8%A9>,
        <https://en.wikipedia.org/wiki/Organization> ;
    skos:definition "المنظّمات جماعات مهيكلة تطوّر الحلول التقنية وتديرها وتنفّذها. وقد تكون شركات أو مؤسّسات حكومية أو هيئات غير ربحية. ومن المنظّمات المعنيّة بالتقنية هيئات التقييس مثل ISO وIEEE وW3C، إضافةً إلى شركات مثل غوغل ومايكروسوفت."@ar,
        "Organizations refer to structured groups that develop, manage, and implement technology solutions. They can be companies, governmental institutions, or non-profit entities. Technology-focused organizations include standards bodies like ISO, IEEE, and W3C, as well as corporations like Google and Microsoft."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Organizations"@en ;
    skos:related wtc:w3c-consortium ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:paas a skos:Concept ;
    skos:broader wtc:cloud-computing ;
    skos:definition "منصّات لتطوير التطبيقات وتشغيلها دون إدارة البنية التحتية، مثل Google App Engine وHeroku."@ar,
        "Platforms for developing and running applications without managing infrastructure (e.g., Google App Engine, Heroku)."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "PaaS (Platform as a Service)"@en ;
    wt:status "current" .

wtc:paradigms a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D9%85%D8%B7_%D8%A8%D8%B1%D9%85%D8%AC%D8%A9>,
        <https://en.wikipedia.org/wiki/Programming_paradigm> ;
    skos:definition "النماذج الإرشادية مقاربات فكرية أو نماذج للبرمجة وتصميم الأنظمة، مثل البرمجة كائنية التوجّه (OOP) والبرمجة الدالّية (Functional Programming) ومنهجية أجايل (Agile)."@ar,
        "Paradigms are philosophical approaches or models of programming and system design, such as Object-Oriented Programming (OOP), Functional Programming, and Agile Methodology."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Paradigms"@en ;
    skos:related wtc:oop ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:phishing a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%B5%D9%8A%D8%AF_%D8%A7%D8%AD%D8%AA%D9%8A%D8%A7%D9%84%D9%8A>,
        <https://en.wikipedia.org/wiki/Phishing> ;
    skos:broader wtc:threats ;
    skos:definition "نوع من هجمات الهندسة الاجتماعية يتنكّر فيه المهاجمون في هيئة جهات موثوقة لسرقة معلومات حسّاسة كأسماء المستخدمين وكلمات السرّ وتفاصيل بطاقات الائتمان."@ar,
        "A type of social engineering attack where attackers disguise themselves as trustworthy entities to steal sensitive information like usernames, passwords, or credit card details."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Phishing"@en ;
    wt:status "current" .

wtc:prompt-engineering a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%87%D9%86%D8%AF%D8%B3%D8%A9_%D8%A7%D9%84%D8%AA%D9%84%D9%82%D9%8A%D9%86>,
        <https://en.wikipedia.org/wiki/Prompt_engineering> ;
    skos:definition "هندسة المُوجَّهات هي هيكلة المُدخَل المقدَّم إلى نموذج لغوي — من تعليمات وسياق وأمثلة وصيغة مخرجات — للحصول على نتائج موثوقة. وأهمّيتها أنّ النموذج نفسه قد ينجح في المهمّة أو يفشل فيها تبعًا لطريقة صياغة الطلب."@ar,
        "Structuring the input to a language model — instructions, context, examples and output format — to get reliable results. It matters because the same underlying model can succeed or fail on a task depending on how the request is framed."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Prompt Engineering"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:qweb a skos:Concept ;
    rdfs:seeAlso <https://www.odoo.com/documentation/15.0/developer/reference/addons/qweb.html> ;
    skos:broader wtc:templating-engines ;
    skos:definition "محرّك قوالب في أودو يُستعمل لتوليد XML وHTML من بيانات النماذج. ويتيح إنشاء محتوى ديناميكي في تطبيقات أودو، ويدعم تصيير التقارير والعروض وسائر القوالب."@ar,
        "A template engine in Odoo used to generate XML/HTML from model data. It allows for the creation of dynamic content in Odoo applications, supporting the rendering of reports, views, and other templates."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "QWeb"@en ;
    wt:status "current" .

wtc:rag a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D9%88%D9%84%D9%8A%D8%AF_%D9%85%D8%B9%D8%B2%D8%B2_%D8%A8%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%AD%D8%B6%D8%A7%D8%B1>,
        <https://arxiv.org/abs/2005.11401>,
        <https://en.wikipedia.org/wiki/Retrieval-augmented_generation> ;
    skos:definition "استرجاع المستندات ذات الصلة وتزويد نموذج لغوي (language model) بها كسياق قبل أن يجيب. يُرسي هذا الإجابات في مدوَّنة نصوص محدَّدة، ما يقلّل الاختلاق ويتيح للنموذج استخدام معلومات لم يُدرَّب عليها قطّ دون إعادة تدريبه."@ar,
        "Retrieving relevant documents and supplying them to a language model as context before it answers. It grounds answers in a specific corpus, which reduces fabrication and lets a model use information it was never trained on without retraining."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "RAG (Retrieval-Augmented Generation)"@en ;
    skos:related wtc:embeddings,
        wtc:knowledge-graphs,
        wtc:vector-databases ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:rdf-rdfs a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A5%D8%B7%D8%A7%D8%B1_%D8%AA%D9%88%D8%B5%D9%8A%D9%81_%D8%A7%D9%84%D9%85%D9%88%D8%A7%D8%B1%D8%AF>,
        <https://en.wikipedia.org/wiki/Resource_Description_Framework>,
        <https://www.w3.org/RDF/> ;
    skos:broader wtc:linked-data ;
    skos:definition "إطار وصف الموارد (RDF) ومخطَّطه (RDFS) معياران لوصف الموارد على الويب بصيغة تقرؤها الآلة."@ar,
        "Resource Description Framework (RDF) and RDF Schema (RDFS) are standards for describing resources on the web in a machine-readable way."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "RDF/ RDFS"@en ;
    skos:related wtc:xml ;
    wt:status "current" .

wtc:scrum a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B3%D9%83%D8%B1%D9%85_%28%D8%AA%D8%B7%D9%88%D9%8A%D8%B1_%D8%A7%D9%84%D8%A8%D8%B1%D9%85%D8%AC%D9%8A%D8%A7%D8%AA%29>,
        <https://en.wikipedia.org/wiki/Scrum_(software_development)>,
        <https://www.scrum.org/> ;
    skos:definition "سكرَم إطار عمل رشيق لإدارة العمل مع تركيز على تطوير البرمجيات. صُمِّم لفرق من عشرة أعضاء أو أقلّ، يقسّمون عملهم إلى أهداف يمكن إنجازها ضمن تكرارات محدَّدة المدّة."@ar,
        "Scrum is an Agile framework for managing work with an emphasis on software development. It is designed for teams of ten or fewer members who break their work into goals that can be completed within time-boxed iterations."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Scrum"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:search-engines a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%AD%D8%B1%D9%83_%D8%A8%D8%AD%D8%AB>,
        <https://en.wikipedia.org/wiki/Search_engine> ;
    skos:definition "محرّكات البحث أنظمة برمجية مصمَّمة لإجراء عمليات البحث في الويب، تتيح للمستخدمين العثور على المعلومات في الشبكة العنكبوتية العالمية. وتعمل بزحف الصفحات وفهرستها وترتيبها بحسب صلتها بالاستعلام. ومن أشهرها غوغل وبينغ وياهو."@ar,
        "Search engines are software systems designed to carry out web searches, allowing users to find information on the World Wide Web. They work by crawling, indexing, and ranking web pages based on relevant queries. Popular search engines include Google, Bing, and Yahoo."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Search Engines"@en ;
    skos:related wtc:seo ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:server a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AE%D8%A7%D8%AF%D9%88%D9%85>,
        <https://en.wikipedia.org/wiki/Server_(computing)> ;
    skos:broader wtc:devices ;
    skos:definition "الخادوم حاسوب أو نظام يوفّر الموارد والبيانات والخدمات أو البرامج لحواسيب أخرى تُسمّى العملاء (clients) عبر شبكة. والخواديم أساسية لاستضافة المواقع والتطبيقات وقواعد البيانات وسائر الخدمات على الإنترنت."@ar,
        "A server is a computer or system that provides resources, data, services, or programs to other computers, known as clients, over a network. Servers are essential for hosting websites, applications, databases, and other online services."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Server"@en ;
    wt:status "current" .

wtc:serverless-architecture a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AD%D9%88%D8%B3%D8%A8%D8%A9_%D8%B9%D8%AF%D9%8A%D9%85%D8%A9_%D8%A7%D9%84%D8%AE%D8%A7%D8%AF%D9%85>,
        <https://aws.amazon.com/serverless/>,
        <https://en.wikipedia.org/wiki/Serverless_computing> ;
    skos:definition "البنية بلا خواديم نموذج تنفيذ في الحوسبة السحابية يشغّل فيه مزوّد السحابة الخادوم ويدير تخصيص موارد الآلة ديناميكيًّا."@ar,
        "Serverless architecture is a cloud computing execution model in which the cloud provider runs the server, and dynamically manages the allocation of machine resources."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Serverless Architecture"@en ;
    skos:related wtc:cloud-computing,
        wtc:paas ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:social-media-integration a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D8%B3%D8%A7%D8%A6%D9%84_%D8%AA%D9%88%D8%A7%D8%B5%D9%84_%D8%A7%D8%AC%D8%AA%D9%85%D8%A7%D8%B9%D9%8A>,
        <https://en.wikipedia.org/wiki/Social_media> ;
    skos:definition "الحقبة التي صارت فيها منصّات التواصل الاجتماعي محورَ التفاعل على الإنترنت، وتكاملت مع خدمات الويب ومواقعه المختلفة."@ar,
        "The era when social media platforms became central to online interaction, integrating with various web services and sites."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Social Media Integration"@en ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:software-engineering a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%87%D9%86%D8%AF%D8%B3%D8%A9_%D8%A7%D9%84%D8%A8%D8%B1%D9%85%D8%AC%D9%8A%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Software_engineering> ;
    skos:definition "التخصّص المعنيّ بالتصميم والتطوير والاختبار والصيانة المنهجية للأنظمة البرمجية. وهو يطبّق مبادئ الهندسة لضمان موثوقية البرمجيات وقابليتها للتوسّع والصيانة على امتداد دورة حياة تطوير البرمجيات (SDLC)."@ar,
        "The discipline focused on the systematic design, development, testing, and maintenance of software systems. It applies engineering principles to ensure software reliability, scalability, and maintainability throughout the software development life cycle (SDLC)."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Software Engineering"@en ;
    skos:related wtc:agile,
        wtc:devops,
        wtc:software ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:static-web-pages a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%8A%D8%A8_2.0>,
        <https://en.wikipedia.org/wiki/Web_1.0> ;
    skos:definition "صفحات الويب الأولى، وكانت بسيطة وساكنة تُقدَّم عبر لغة الترميز (HTML) دون أيّ خصائص ديناميكية أو تفاعلية."@ar,
        "Early web pages that were simple, static, and delivered via HTML, without any dynamic features or interactivity."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Static Web Pages"@en ;
    skos:related wtc:astro,
        wtc:jamstack ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:streaming-responses a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/API/Server-sent_events>,
        <https://developer.mozilla.org/en-US/docs/Web/API/Streams_API> ;
    skos:definition "تسليم الاستجابة تدريجيًّا وهي تُنتَج بدل انتظار اكتمالها، عادةً عبر الأحداث المُرسَلة من الخادوم (SSE) أو عبر مجرى قابل للقراءة. وهو ما يجعل جواب النموذج يظهر رمزًا بعد رمز بدل ظهوره بعد صمت طويل."@ar,
        "Delivering a response incrementally as it is produced rather than waiting for it to complete, usually over Server-Sent Events or a readable stream. It is what makes a model's answer appear token by token instead of after a long pause."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Streaming Responses"@en ;
    skos:related wtc:websockets ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:svelte a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B3%D9%81%D9%84%D8%AA>,
        <https://en.wikipedia.org/wiki/Svelte>,
        <https://svelte.dev/> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "إطار عمل لواجهات المستخدم ينقل معظم عمله إلى وقت البناء: تُترجَم المكوّنات إلى جافاسكريبت تحدّث DOM مباشرةً، فلا يُرسَل إلى المتصفّح زمن تشغيل للإطار ولا DOM افتراضي."@ar,
        "A UI framework that shifts most of its work to build time: components compile into direct DOM-updating JavaScript, so no framework runtime or virtual DOM ships to the browser."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Svelte"@en ;
    wt:status "current" .

wtc:tcp-ip a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AD%D8%B2%D9%85%D8%A9_%D8%A8%D8%B1%D9%88%D8%AA%D9%88%D9%83%D9%88%D9%84%D8%A7%D8%AA_%D8%A7%D9%84%D8%A5%D9%86%D8%AA%D8%B1%D9%86%D8%AA>,
        <https://en.wikipedia.org/wiki/Internet_protocol_suite>,
        <https://www.ietf.org/standards/rfcs/> ;
    skos:broader wtc:protocols ;
    skos:definition "بروتوكولات الاتّصال الأساسية للإنترنت، وهي المسؤولة عن التوجيه وعن ضمان سلامة البيانات عبر الشبكات."@ar,
        "The foundational communication protocols of the internet, responsible for routing and ensuring data integrity across networks."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "TCP/IP"@en ;
    wt:status "current" .

wtc:templating-engines a skos:Concept ;
    skos:broader wtc:odoo-framework ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Templating Engines"@en ;
    wt:status "current" .

wtc:trends a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Technology_trend> ;
    skos:definition "الاتّجاهات تمثّل التقنيات والمنهجيات الناشئة في قطاع التقنية. ومن أمثلتها الرسوم المعرفية (Knowledge Graphs) والذكاء الاصطناعي وتعلُّم الآلة (AI/ML) والحوسبة الطرفية (edge computing) والبنى بلا خواديم (serverless) وسلسلة الكتل (blockchain)."@ar,
        "Trends represent emerging technologies and methodologies in the tech industry. Examples include Knowledge Graphs, AI/ML, edge computing, serverless architectures, and blockchain."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Trends"@en ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:typescript a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%A7%D9%8A%D8%A8_%D8%B3%D9%83%D8%B1%D9%8A%D8%A8%D8%AA>,
        <https://en.wikipedia.org/wiki/TypeScript>,
        <https://www.typescriptlang.org/> ;
    skos:broader wtc:javascript ;
    skos:definition "مجموعة عليا مُنمَّطة من جافاسكريبت (JavaScript) تُترجَم إلى جافاسكريبت عادية. تُفحَص الأنواع (types) قبل تشغيل الشيفرة ثم تُحذَف، فتلتقط TypeScript صنفًا كاملًا من الأخطاء وقت البناء بينما تُرسل إلى المتصفّح جافاسكريبت عادية. وهي اليوم الخيار الافتراضي لقواعد الشيفرة الكبيرة في الواجهة الأمامية وفي Node."@ar,
        "A typed superset of JavaScript that compiles to plain JavaScript. Types are checked before the code runs and then erased, so TypeScript catches a whole class of errors at build time while shipping ordinary JavaScript to the browser. It is now the default choice for large front-end and Node codebases."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "TypeScript"@en ;
    wt:status "current" .

wtc:unicode-inc a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AC%D9%85%D8%B9%D9%8A%D8%A9_%D8%A7%D9%84%D8%AA%D8%B1%D9%85%D9%8A%D8%B2_%D8%A7%D9%84%D9%85%D9%88%D8%AD%D8%AF>,
        <https://en.wikipedia.org/wiki/Unicode_Consortium>,
        <https://home.unicode.org/> ;
    skos:definition "يونيكود المسجَّلة، المعروفة باسم اتّحاد يونيكود، منظّمة غير ربحية تطوّر معيار يونيكود وتصونه، وهو نظام ترميز محارف عالمي لتمثيل النصّ عبر المنصّات والأجهزة المختلفة. وهذا المعيار أساسيّ لإتاحة تبادل بيانات النصّ باتّساق عبر الإنترنت وغيره من المنصّات."@ar,
        "Unicode, Inc., commonly known as the Unicode Consortium, is a non-profit organization that develops and maintains the Unicode Standard, a universal character encoding scheme for text representation across different platforms and devices. This standard is essential for enabling consistent text data interchange across the internet and other platforms."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Unicode, Inc. (Unicode Consortium)"@en ;
    skos:related wtc:unicode ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:uri-url a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%B9%D8%B1%D9%81_%D8%A7%D9%84%D9%85%D9%88%D8%A7%D8%B1%D8%AF_%D8%A7%D9%84%D9%85%D9%88%D8%AD%D8%AF>,
        <https://en.wikipedia.org/wiki/Uniform_Resource_Identifier>,
        <https://tools.ietf.org/html/rfc3986> ;
    skos:broader wtc:data-acces ;
    skos:definition "المعرّف الموحّد للموارد (URI) ومحدّد موقع الموارد الموحّد (URL) طريقتان معياريتان لتعريف الموارد على الويب وتحديد مواقعها."@ar,
        "Uniform Resource Identifier (URI) and Uniform Resource Locator (URL) are standardized methods to identify and locate resources on the web."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "URI/URL"@en ;
    skos:related wtc:restful-apis ;
    wt:status "current" .

wtc:vite a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%81%D9%8A%D8%AA_%D8%AC%D9%8A_%D8%A5%D8%B3>,
        <https://en.wikipedia.org/wiki/Vite_(software)>,
        <https://vite.dev/> ;
    skos:broader wtc:build-tooling ;
    skos:definition "أداة البناء الأمامية المعيارية بحكم الأمر الواقع. في التطوير تقدّم وحدات ES أصيلة فيبقى الإقلاع شبه فوريّ مهما كبر المشروع، وللإنتاج تحزّم باستعمال Rollup."@ar,
        "The de facto standard front-end build tool. In development it serves native ES modules so startup stays near-instant regardless of project size, and for production it bundles with Rollup."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Vite"@en ;
    skos:related wtc:esm ;
    wt:status "current" .

wtc:vue-js a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%81%D9%8A%D9%88_%D8%AC%D9%8A_%D8%A5%D8%B3>,
        <https://en.wikipedia.org/wiki/Vue.js>,
        <https://vuejs.org/> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "‏Vue.js إطار عمل جافاسكريبت تدرّجي يُستعمل لبناء واجهات المستخدم وتطبيقات الصفحة الواحدة. وهو مصمَّم ليُتبنّى تدريجيًّا، أي يمكنك البدء بالقليل أو الكثير منه ثمّ التوسّع. ويُعرَف ببساطته ومرونته وسهولة تكامله مع المكتبات الأخرى أو المشاريع القائمة."@ar,
        "Vue.js is a progressive JavaScript framework used for building user interfaces and single-page applications. It is designed to be incrementally adoptable, meaning you can start with as little or as much of Vue as you like and scale up from there. Vue.js is known for its simplicity, flexibility, and ease of integration with other libraries or existing projects."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Vue.js"@en ;
    wt:status "current" .

wtc:web3-disambiguation a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%8A%D8%A8_%D8%AF%D9%84%D8%A7%D9%84%D9%8A>,
        <https://en.wikipedia.org/wiki/Semantic_Web>,
        <https://en.wikipedia.org/wiki/Web3> ;
    skos:definition "يُخلَط بين هذين المصطلحين على نحو معتاد، وهما لا يعنيان الشيء نفسه. في هذه الخريطة الذهنية، وفي الاستعمال الأكاديمي، تعني **الويب 3.0** *الويب الدلالي*: برنامج W3C لجعل البيانات مقروءة آليًّا عبر RDF والأنطولوجيات والبيانات المترابطة، حتى تستطيع البرمجيات الاستدلال على المعنى بدل تحليل التخطيط. أمّا **Web3** فمصطلح منفصل ولاحق نشأ في قطاع العملات المشفَّرة، ويصف التطبيقات اللامركزية القائمة على سلسلة الكتل وملكية الرموز. ويتشارك المساران طموح اللامركزية، ولا يكادان يتشاركان غير ذلك: هيئات تقييس مختلفة، وتقنيات مختلفة، ومجتمعات بحثية مختلفة. فإذا قرأت «Web 3.0» في درس ما، فتحقّق أيّ المعنيين يُقصَد."@ar,
        "These two terms are routinely confused, and they do not mean the same thing. In this mind map, and in academic usage, **Web 3.0** means the *Semantic Web*: the W3C programme of making data machine-readable through RDF, ontologies and linked data, so that software can reason over meaning rather than parse layout. **Web3** is a separate, later coinage from the cryptocurrency industry, describing blockchain-based decentralised applications and token ownership. The two agendas share the ambition of decentralisation but almost nothing else: different standards bodies, different technologies, different research communities. When you read \"Web 3.0\" in a tutorial, check which one is meant."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Web3 vs Web 3.0 — a note on terminology"@en ;
    skos:related wtc:blockchain-and-decentralization,
        wtc:knowledge-graphs,
        wtc:linked-data ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:webgpu a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%8A%D8%A8_%D8%AC%D9%8A_%D8%A8%D9%8A_%D9%8A%D9%88>,
        <https://developer.mozilla.org/en-US/docs/Web/API/WebGPU_API>,
        <https://en.wikipedia.org/wiki/WebGPU>,
        <https://www.w3.org/TR/webgpu/> ;
    skos:definition "واجهة برمجة في المتصفّح تكشف قدرات وحدة المعالجة الرسومية الحديثة للتصيير وللحوسبة العامّة معًا، وهي خليفة WebGL. وتجعل أعمال الرسوميات الجادّة والاستدلال بتعلُّم الآلة داخل المتصفّح أمرًا عمليًّا على منصّة الويب."@ar,
        "A browser API exposing modern GPU capability for both rendering and general computation, succeeding WebGL. It makes serious graphics work and in-browser machine-learning inference practical on the web platform."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "WebGPU"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "emerging" .

wtc:webrtc a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%8A%D8%A8_%D8%A2%D8%B1_%D8%AA%D9%8A_%D8%B3%D9%8A>,
        <https://en.wikipedia.org/wiki/WebRTC>,
        <https://webrtc.org/>,
        <https://www.w3.org/TR/webrtc/> ;
    skos:definition "مجموعة واجهات برمجة للصوت والفيديو والبيانات آنيًّا بين المتصفّحات مباشرةً، دون إضافة برمجية، وغالبًا دون تمرير عبر خادوم بعد إتمام الاتّصال. وعليها يقوم معظم الاتّصال والاجتماعات عبر المتصفّح."@ar,
        "A set of APIs for real-time audio, video and data directly between browsers, without a plugin and, once connected, often without relaying through a server. It underpins most browser-based calling and conferencing."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "WebRTC"@en ;
    skos:related wtc:websockets ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:xss a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%85%D8%AC%D8%A9_%D8%B9%D8%A7%D8%A8%D8%B1%D8%A9_%D9%84%D9%84%D9%85%D9%88%D8%A7%D9%82%D8%B9>,
        <https://en.wikipedia.org/wiki/Cross-site_scripting> ;
    skos:broader wtc:threats ;
    skos:definition "هجوم تُحقَن فيه نصوص برمجية خبيثة داخل مواقع موثوقة، ما يمكّن المهاجم من سرقة بيانات المستخدمين أو اختطاف جلساتهم (sessions)."@ar,
        "An attack where malicious scripts are injected into trusted websites, enabling attackers to steal user data or hijack user sessions."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "XSS (Cross-Site Scripting)"@en ;
    skos:related wtc:dom-manipulation ;
    wt:status "current" .

wtc:agents a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%83%D9%8A%D9%84_%D8%B0%D9%83%D9%8A>,
        <https://en.wikipedia.org/wiki/Intelligent_agent> ;
    skos:definition "في علوم الحاسوب، الوكيل (agent) كيان قادر على التصرّف باستقلالية داخل بيئة ما. وقد يكون الوكلاء بشرًا، أو برمجيات كروبوتات المحادثة والوكلاء الأذكياء، أو عتادًا كالروبوتات. وهم يؤدّون مهامّ مثل اتّخاذ القرار والتعلّم والتفاعل مع وكلاء أو أنظمة أخرى."@ar,
        "In computer science, an agent is an entity capable of autonomous action in an environment. Agents can be humans, software-based (e.g., chatbots, intelligent agents) or hardware-based (e.g., robots). They perform tasks such as decision-making, learning, and interacting with other agents or systems."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Agents"@en ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:agile a skos:Concept ;
    rdfs:seeAlso <https://agilemanifesto.org/>,
        <https://ar.wikipedia.org/wiki/%D8%A3%D8%AC%D8%A7%D9%8A%D9%84_%28%D9%85%D8%A8%D8%A7%D8%AF%D8%A6_%D8%AA%D8%B7%D9%88%D9%8A%D8%B1_%D8%A8%D8%B1%D9%85%D8%AC%D9%8A%D8%A7%D8%AA%29>,
        <https://en.wikipedia.org/wiki/Agile_software_development> ;
    skos:definition "أجايل مجموعة مبادئ لتطوير البرمجيات تتطوّر بموجبها المتطلّبات والحلول عبر الجهد التعاوني لفرق ذاتية التنظيم ومتعدّدة الاختصاصات."@ar,
        "Agile is a set of principles for software development under which requirements and solutions evolve through the collaborative effort of self-organizing and cross-functional teams."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Agile"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:ai-agents a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%83%D9%8A%D9%84_%D8%B0%D9%83%D9%8A>,
        <https://en.wikipedia.org/wiki/Intelligent_agent> ;
    skos:definition "أنظمة يخطّط فيها نموذج لغوي لمهامّ متعدّدة الخطوات وينفّذها باستدعاء الأدوات والتفاعل مع نتائجها، بدل إنتاج النصّ وحده. وهذا هو المفهوم الكلاسيكي لوكيل البرمجيات، مع نموذج يتولّى اتّخاذ القرار."@ar,
        "Systems in which a language model plans and carries out multi-step tasks by calling tools and reacting to the results, rather than only producing text. This is the classical notion of a software agent, with a model supplying the decision-making."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "AI Agents"@en ;
    skos:related wtc:agents,
        wtc:autonomous-systems,
        wtc:mcp ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "emerging" .

wtc:algorithms a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AE%D9%88%D8%A7%D8%B1%D8%B2%D9%85%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Algorithm> ;
    skos:definition "الخوارزميات هي مجموعات من التعليمات أو القواعد المصمَّمة لأداء مهامّ محدَّدة أو حلّ المشكلات بكفاءة. وهي أساس البرمجة (programming) والأتمتة (automation) في الحوسبة."@ar,
        "Algorithms are sets of instructions or rules designed to perform specific tasks or solve problems efficiently. They are the foundation of programming and automation in computing."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Algorithms"@en ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:blockchain-and-decentralization a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D9%81%D9%83%D9%8A%D9%83_%D8%A7%D9%84%D9%88%D9%8A%D8%A8>,
        <https://en.wikipedia.org/wiki/Decentralized_web> ;
    skos:definition "مفهوم توزيع البيانات على عقد أو شبكات متعدّدة لتعزيز الأمن والحدّ من المركزية، ويُقرَن غالبًا بتقنية سلسلة الكتل (blockchain)."@ar,
        "The concept of distributing data across multiple nodes or networks to enhance security and reduce centralization, often associated with blockchain technology."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Blockchain and Decentralization"@en ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:deep-learning a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%B9%D9%84%D9%85_%D8%B9%D9%85%D9%8A%D9%82>,
        <https://en.wikipedia.org/wiki/Deep_learning> ;
    skos:broader wtc:supervised-unsupervised-learning ;
    skos:definition "التعلّم العميق فرع من تعلُّم الآلة يستعمل شبكات عصبية ذات طبقات كثيرة، ومن هنا وصف «العميق»، لنمذجة الأنماط المعقّدة في البيانات. وهو فعّال بوجه خاصّ في مهامّ كالتعرّف على الصور ومعالجة الكلام وفهم اللغة الطبيعية."@ar,
        "Deep learning is a subset of machine learning that uses neural networks with many layers (hence \"deep\") to model complex patterns in data. Deep learning is particularly effective for tasks such as image recognition, speech processing, and natural language understanding."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Deep Learning"@en ;
    wt:status "current" .

wtc:devops a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AF%D9%8A%D9%81_%D8%A3%D9%88%D8%A8%D8%B3>,
        <https://aws.amazon.com/devops/what-is-devops/>,
        <https://en.wikipedia.org/wiki/DevOps> ;
    skos:definition "مجموعة ممارسات (DevOps) تجمع بين تطوير البرمجيات (Dev) وعمليات تقنية المعلومات (Ops). وتهدف إلى تقصير دورة حياة تطوير الأنظمة وتوفير تسليم مستمرّ بجودة برمجية عالية."@ar,
        "DevOps is a set of practices that combines software development (Dev) and IT operations (Ops). It aims to shorten the systems development life cycle and provide continuous delivery with high software quality."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "DevOps"@en ;
    skos:related wtc:docker,
        wtc:git,
        wtc:kubernetes ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:dom-manipulation a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D9%85%D9%88%D8%B0%D8%AC_%D9%83%D8%A7%D8%A6%D9%86_%D8%A7%D9%84%D9%85%D8%B3%D8%AA%D9%86%D8%AF>,
        <https://en.wikipedia.org/wiki/Document_Object_Model>,
        <https://youtu.be/jrBhi8wbzPw?si=VBfKr147HqnytXIk> ;
    skos:broader wtc:javascript ;
    skos:definition "القدرة على التفاعل مع نموذج كائن المستند (DOM) لصفحة الويب وتحديثه باستعمال جافاسكريبت."@ar,
        "The ability to interact with and update the Document Object Model (DOM) of a web page using JavaScript."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "DOM Manipulation"@en ;
    wt:status "current" .

wtc:embeddings a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Word_embedding> ;
    skos:definition "متّجهات عددية تمثّل النصّ أو الصور أو غيرها من البيانات، بحيث تتقارب في فضاء المتّجهات العناصر المتقاربة في المعنى. وهي ما يجعل البحث بالمعنى، لا بالكلمة المفتاحية، ممكنًا."@ar,
        "Numeric vectors representing text, images or other data such that items close in meaning are close in the vector space. They are what makes search by meaning rather than by keyword possible."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Embeddings"@en ;
    skos:related wtc:deep-learning,
        wtc:vector-databases ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:esm a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Modules>,
        <https://tc39.es/ecma262/#sec-modules> ;
    skos:broader wtc:javascript ;
    skos:definition "نظام الوحدات المعياري في جافاسكريبت، ويستعمل import وexport. تدعمه المتصفّحات وNode دعمًا أصيلًا، ممّا أنهى الانقسام الطويل بين صيغ الوحدات المتنافسة مثل CommonJS وAMD."@ar,
        "JavaScript's standard module system, using `import` and `export`. Browsers and Node both support it natively, which ended the long split between competing module formats such as CommonJS and AMD."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "ES Modules (ESM)"@en ;
    skos:related wtc:es6-features ;
    wt:status "current" .

wtc:git a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%BA%D9%8A%D8%AA_%28%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%29>,
        <https://en.wikipedia.org/wiki/Git>,
        <https://git-scm.com/>,
        <https://youtu.be/NcoBAfJ6l2Q?si=W8uoDwk_akNihWOF> ;
    skos:definition "نظام تحكّم بالإصدارات موزَّع لتتبّع التغييرات في الشيفرة المصدرية أثناء تطوير البرمجيات."@ar,
        "A distributed version-control system for tracking changes in source code during software development."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Git"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:graphql a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%BA%D8%B1%D8%A7%D9%81_%D9%83%D9%8A%D9%88_%D8%A5%D9%84>,
        <https://en.wikipedia.org/wiki/GraphQL>,
        <https://graphql.org/> ;
    skos:definition "لغة استعلام لواجهة برمجة التطبيقات (GraphQL)، وزمن تشغيل من جانب الخادوم لتنفيذ الاستعلامات باستعمال نظام أنواع تعرّفه لبياناتك. وهي بديل أكفأ وأقوى وأمرن من REST."@ar,
        "GraphQL is a query language for your API, and a server-side runtime for executing queries by using a type system you define for your data. It provides a more efficient, powerful, and flexible alternative to REST."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "GraphQL"@en ;
    skos:related wtc:restful-apis ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:html5 a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%84%D8%BA%D8%A9_%D8%AA%D8%A3%D8%B4%D9%8A%D8%B1_%D8%A7%D9%84%D9%86%D8%B5_%D8%A7%D9%84%D8%AA%D8%B1%D8%A7%D8%A8%D8%B7%D9%8A_5>,
        <https://en.wikipedia.org/wiki/HTML5>,
        <https://www.w3.org/TR/html5/> ;
    skos:broader wtc:html-css ;
    skos:definition "أحدث إصدار من لغة ترميز النصّ الفائق (HTML)، ويوفّر عناصر وسمات وسلوكيات جديدة."@ar,
        "The latest version of HTML, providing new elements, attributes, and behaviors."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "HTML5"@en ;
    wt:status "current" .

wtc:knowledge-graphs a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Knowledge_Graph> ;
    skos:broader wtc:linked-data ;
    skos:definition "الرسم المعرفي يمثّل شبكة من الكيانات في العالم الواقعي ويبيّن العلاقة بينها."@ar,
        "A knowledge graph represents a network of real-world entities and illustrates the relationship between them."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Knowledge Graphs"@en ;
    skos:related wtc:graph-databases ;
    wt:status "current" .

wtc:kubernetes a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%83%D9%88%D8%A8%D9%8A%D8%B1%D9%86%D9%8A%D8%AA%D9%8A%D8%B3>,
        <https://en.wikipedia.org/wiki/Kubernetes>,
        <https://kubernetes.io/> ;
    skos:definition "نظام تنسيق حاويات مفتوح المصدر (Kubernetes) لأتمتة نشر البرمجيات وتوسيعها وإدارتها."@ar,
        "Kubernetes is an open-source container-orchestration system for automating software deployment, scaling, and management."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Kubernetes"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:llm a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D9%85%D9%88%D8%B0%D8%AC_%D9%84%D8%BA%D9%88%D9%8A_%D9%83%D8%A8%D9%8A%D8%B1>,
        <https://en.wikipedia.org/wiki/Large_language_model> ;
    skos:definition "نماذج مدرَّبة على مدوَّنات نصّية ضخمة جدًّا تتنبّأ بتتمّة المُوجَّه (prompt)، وتؤدّي بذلك مهامّ لم تُبرمَج لها صراحةً. ويُوصَل إليها عبر واجهات برمجة HTTP، فصارت مكوّنًا عاديًّا في تطبيقات الويب لا أداةً بحثية متخصّصة."@ar,
        "Models trained on very large text corpora that predict continuations of a prompt, and in doing so perform tasks they were not explicitly programmed for. Accessed over HTTP APIs, they have become an ordinary component of web applications rather than a specialist research tool."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "LLMs (Large Language Models)"@en ;
    skos:related wtc:deep-learning,
        wtc:nlp ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:mcp a skos:Concept ;
    rdfs:seeAlso <https://modelcontextprotocol.io/> ;
    skos:definition "بروتوكول مفتوح لربط النماذج اللغوية بالأدوات ومصادر البيانات الخارجية عبر واجهة موحَّدة، فيعمل التكامل المكتوب مرّةً واحدة عبر عملاء مختلفين بدل إعادة بنائه لكلّ تطبيق."@ar,
        "An open protocol for connecting language models to external tools and data sources through a common interface, so an integration written once works across different clients instead of being rebuilt per application."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "MCP (Model Context Protocol)"@en ;
    skos:related wtc:ai-agents,
        wtc:restful-apis ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "emerging" .

wtc:node-js a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%86%D9%88%D8%AF.%D8%AC%D9%8A_%D8%A5%D8%B3>,
        <https://en.wikipedia.org/wiki/Node.js>,
        <https://nodejs.org/> ;
    skos:broader wtc:server-side-programming ;
    skos:definition "بيئة تشغيل لجافاسكريبت مبنيّة على محرّك V8 الخاصّ بكروم، مصمَّمة لبناء تطبيقات شبكية قابلة للتوسّع."@ar,
        "A JavaScript runtime built on Chrome's V8 engine, designed for building scalable network applications."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Node.js"@en ;
    wt:status "current" .

wtc:programming a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%85%D8%AC%D8%A9>,
        <https://en.wikipedia.org/wiki/Computer_programming> ;
    skos:definition "تخصّص كتابة الشيفرة لإنشاء التطبيقات والأنظمة البرمجية باستخدام لغات برمجة مثل Python وJava وC++."@ar,
        "The discipline of writing code to create software applications and systems using programming languages such as Python, Java, and C++."@en ;
    skos:inScheme wts:00-disciplines ;
    skos:prefLabel "Programming"@en ;
    skos:related wtc:oop,
        wtc:server-side-programming ;
    skos:topConceptOf wts:00-disciplines ;
    wt:status "current" .

wtc:progressive-web-apps a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%B7%D8%A8%D9%8A%D9%82_%D9%88%D9%8A%D8%A8_%D8%AA%D9%82%D8%AF%D9%85%D9%8A>,
        <https://developers.google.com/web/progressive-web-apps>,
        <https://en.wikipedia.org/wiki/Progressive_web_application> ;
    skos:definition "تطبيقات الويب التقدّمية تطبيقات ويب عُزِّزت بتقنيات ويب حديثة لتقديم تجربة شبيهة بتطبيقات الجوال. وتستطيع العمل دون اتّصال، وإرسال الإشعارات الفورية، والتثبيت على الشاشة الرئيسة للجهاز."@ar,
        "Progressive Web Apps are web applications that have been enhanced with modern web technologies to deliver an app-like experience to users. They can work offline, send push notifications, and be installed on a device's home screen."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Progressive Web Apps (PWAs)"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:python-php a skos:Concept ;
    skos:broader wtc:server-side-programming ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Python/PHP"@en ;
    wt:status "current" .

wtc:react-js a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B1%D9%8A%D8%A7%D9%83%D8%AA>,
        <https://en.wikipedia.org/wiki/React_(JavaScript_library)>,
        <https://reactjs.org/> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "مكتبة جافاسكريبت لبناء واجهات المستخدم، تصونها فيسبوك ومجتمع من المطوّرين."@ar,
        "A JavaScript library for building user interfaces, maintained by Facebook and a community of developers."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "React.js"@en ;
    wt:status "current" .

wtc:software a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%85%D8%AC%D9%8A%D8%A7%D8%AA>,
        <https://en.wikipedia.org/wiki/Software> ;
    skos:definition "البرمجيات هي البرامج وأنظمة التشغيل التي توجّه العتاد لأداء مهامّ محدَّدة. وتُصنَّف إلى برمجيات نظام كأنظمة التشغيل، وبرمجيات تطبيقية كمعالجات النصوص."@ar,
        "Software consists of programs and operating systems that direct hardware to perform specific tasks. Software is categorized into system software (e.g., operating systems) and application software (e.g., word processors)."@en ;
    skos:inScheme wts:00-pillars ;
    skos:prefLabel "Software"@en ;
    skos:topConceptOf wts:00-pillars ;
    wt:status "current" .

wtc:spas a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%B7%D8%A8%D9%8A%D9%82_%D8%A7%D9%84%D8%B5%D9%81%D8%AD%D8%A9_%D8%A7%D9%84%D9%88%D8%A7%D8%AD%D8%AF%D8%A9_%28%D9%88%D9%8A%D8%A8%29>,
        <https://en.wikipedia.org/wiki/Single-page_application> ;
    skos:broader wtc:hydration ;
    skos:definition "تطبيقات الصفحة الواحدة تطبيقات ويب تحمّل صفحة HTML واحدة وتحدّث المحتوى ديناميكيًّا كلّما تفاعل المستخدم معها. وهذا يوفّر تجربة سلسة بإلغاء الحاجة إلى إعادة تحميل الصفحة كاملةً. ومن أمثلتها Gmail وخرائط غوغل."@ar,
        "SPAs are web applications that load a single HTML page and dynamically update content as the user interacts with the app. This provides a seamless user experience by eliminating the need for full page reloads. Examples of SPAs include Gmail and Google Maps."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "SPAs (Single Page Applications)"@en ;
    wt:status "current" .

wtc:supervised-unsupervised-learning a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%B9%D9%84%D9%85_%D9%85%D8%B1%D8%A7%D9%82%D8%A8>,
        <https://en.wikipedia.org/wiki/Supervised_learning>,
        <https://en.wikipedia.org/wiki/Unsupervised_learning> ;
    skos:broader wtc:statistical-ai ;
    skos:definition "التعلّم المُوجَّه يقوم على تدريب نموذج تعلُّم الآلة على بيانات موسومة، فتتعلّم الخوارزمية ربط المدخلات بالمخرجات. أمّا التعلّم غير المُوجَّه فيقوم على اكتشاف الأنماط في البيانات دون وسوم صريحة، ويُستعمل كثيرًا في التجميع (clustering) وكشف الشذوذ."@ar,
        "Supervised learning involves training a machine learning model on labeled data, where the algorithm learns to map inputs to outputs. Unsupervised learning, on the other hand, involves discovering patterns in data without explicit labels, often used for clustering or anomaly detection."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Supervised/Unsupervised Learning"@en ;
    wt:status "current" .

wtc:vector-databases a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Vector_space_model> ;
    skos:broader wtc:databases-2 ;
    skos:definition "قواعد البيانات المتّجهية قواعد متخصّصة صُمِّمت لتخزين المتّجهات عالية الأبعاد وفهرستها والاستعلام عنها. وهي أساسية لتطبيقات تعلُّم الآلة، ولا سيّما البحث بالتشابه، حيث الهدف إيجاد أقرب المتّجهات شبهًا بمتّجه الاستعلام. وتُستعمل في سياقات كأنظمة التوصية ومعالجة اللغات الطبيعية والرؤية الحاسوبية."@ar,
        "Vector databases are specialized databases designed to store, index, and query high-dimensional vectors. These databases are crucial for machine learning applications, particularly for similarity search, where the goal is to find vectors that are most similar to a given query vector. Vector databases are used in contexts such as recommendation systems, natural language processing, and computer vision."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Vector Databases"@en ;
    wt:status "current" .

wtc:virtualization a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%AD%D8%A7%D9%83%D8%A7%D8%A9_%D8%A7%D9%81%D8%AA%D8%B1%D8%A7%D8%B6%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Virtualization> ;
    skos:definition "المحاكاة الافتراضية عملية إنشاء نُسَخ افتراضية من الموارد المادّية كالخواديم والتخزين والشبكات. وباستعمال برمجيات كمراقبات الأجهزة الافتراضية (hypervisors) يمكن تشغيل عدّة أجهزة افتراضية (VMs) على آلة مادّية واحدة، ممّا يحسّن استغلال الموارد ويوفّر مرونة في بيئات السحابة. وهي تقنية أساسية في الحوسبة السحابية، تتيح تخصيص موارد الحوسبة بكفاءة وعزل البيئات لأغراض الأمن وقابلية التوسّع."@ar,
        "Virtualization is the process of creating virtual instances of physical resources, such as servers, storage, or networks. By using software like hypervisors, multiple virtual machines (VMs) can run on a single physical machine, optimizing resource use and providing flexibility in cloud environments. Virtualization is a key technology in cloud computing, enabling efficient allocation of computing resources and isolation of environments for security and scalability."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Virtualization"@en ;
    skos:related wtc:docker ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:w3c-consortium a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B1%D8%A7%D8%A8%D8%B7%D8%A9_%D8%A7%D9%84%D8%B4%D8%A8%D9%83%D8%A9_%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/World_Wide_Web_Consortium>,
        <https://www.w3.org/> ;
    skos:definition "يؤدّي اتّحاد الشبكة العنكبوتية العالمية (W3C) دورًا محوريًّا في تقييس تقنيات الويب. وهو مجتمع دولي يطوّر معايير مفتوحة تضمن نموّ الويب على المدى الطويل. ويتولّى إنشاء كثير من المعايير الأساسية المستعملة في بناء المواقع وصيانتها، ومنها HTML وCSS وXML، بما يكفل قابلية التشغيل البيني وإتاحة تقنيات الويب."@ar,
        "The World Wide Web Consortium (W3C) has a central role in standardizing web technologies. It is an international community that develops open standards to ensure the long-term growth of the web. W3C is responsible for creating and maintaining many of the key standards used to build websites, including HTML, CSS, and XML, ensuring the interoperability and accessibility of web technologies."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "W3C Consortium (World Wide Web Consortium)"@en ;
    skos:related wtc:html5,
        wtc:rdf-rdfs,
        wtc:web-components ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:web-components a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/Web_Components>,
        <https://en.wikipedia.org/wiki/Web_Components> ;
    skos:definition "مكوّنات الويب مجموعة من واجهات برمجة منصّة الويب تتيح إنشاء وسوم HTML جديدة قابلة لإعادة الاستعمال ومغلَّفة، تُستعمل في صفحات الويب وتطبيقاته."@ar,
        "Web Components are a set of web platform APIs that allow you to create new, reusable, encapsulated HTML tags to use in web pages and web apps."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Web Components"@en ;
    skos:related wtc:frameworks-and-libraries ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:webassembly a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%88%D9%8A%D8%A8_%D8%A3%D8%B3%D9%85%D8%A8%D9%84%D9%8A>,
        <https://en.wikipedia.org/wiki/WebAssembly>,
        <https://webassembly.org/> ;
    skos:definition "صيغة تعليمات ثنائية (WebAssembly، أو Wasm) لآلة افتراضية قائمة على المكدّس، تتيح تطبيقات عالية الأداء في صفحات الويب. وهي مصمَّمة لتكون هدف ترجمة قابلًا للنقل للغات البرمجة، بما يتيح النشر على الويب لتطبيقات العميل والخادوم."@ar,
        "WebAssembly (Wasm) is a binary instruction format for a stack-based virtual machine, enabling high-performance applications on web pages. It is designed as a portable compilation target for programming languages, enabling deployment on the web for client and server applications."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "WebAssembly"@en ;
    skos:related wtc:javascript ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:websockets a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D9%82%D8%A8%D8%B3_%D9%88%D9%8A%D8%A8>,
        <https://en.wikipedia.org/wiki/WebSocket> ;
    skos:broader wtc:web-services-and-apis ;
    skos:definition "بروتوكول يوفّر قنوات اتّصال ثنائية الاتّجاه بالكامل عبر اتّصال TCP واحد، ويُستعمل أساسًا للتطبيقات الآنية."@ar,
        "A protocol that provides full-duplex communication channels over a single TCP connection, primarily used for real-time applications."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "WebSockets"@en ;
    wt:status "current" .

wtc:xml a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%84%D8%BA%D8%A9_%D8%A7%D9%84%D8%AA%D8%A3%D8%B4%D9%8A%D8%B1_%D8%A7%D9%84%D9%88%D8%B3%D9%88%D8%B9%D8%A9>,
        <https://drive.google.com/drive/folders/12jb9iion-lCvHaJTKK7tKtvmKDJmjoOI>,
        <https://en.wikipedia.org/wiki/XML>,
        <https://www.w3.org/XML/> ;
    skos:broader wtc:data-exchange-formats ;
    skos:definition "لغة الترميز الموسَّعة (XML) طريقة مرنة لإنشاء صيغ معلومات مشتركة وتبادل البيانات عبر الإنترنت."@ar,
        "Extensible Markup Language (XML) is a flexible way to create common information formats and share data across the internet."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "XML"@en ;
    skos:related wtc:qweb ;
    wt:status "current" .

wtc:browsers a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%85%D8%AA%D8%B5%D9%81%D8%AD_%D9%88%D9%8A%D8%A8>,
        <https://en.wikipedia.org/wiki/Web_browser> ;
    skos:definition "متصفّحات الويب تطبيقات برمجية تُستعمل للوصول إلى محتوى الشبكة العنكبوتية العالمية واسترجاعه وعرضه. وتفسّر المتصفّحات HTML وCSS وJavaScript لتصيير الصفحات، وتوفّر واجهة للتفاعل مع المحتوى. ومن أشهرها غوغل كروم وموزيلا فايرفوكس ومايكروسوفت إيدج وسفاري."@ar,
        "Web browsers are software applications used to access, retrieve, and display content from the World Wide Web. Browsers interpret HTML, CSS, and JavaScript to render web pages and provide a user interface for interacting with online content. Popular browsers include Google Chrome, Mozilla Firefox, Microsoft Edge, and Safari."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Browsers"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:build-tooling a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Build_automation> ;
    skos:definition "البرامج التي تحوّل ملفّات المصدر إلى ما يحمّله المتصفّح فعلًا: حلّ الوحدات، وترجمة TypeScript وJSX، والتحزيم، والتصغير، وتشغيل خادوم تطوير سريع بإعادة تحميل فورية."@ar,
        "The programs that turn source files into what the browser actually loads: resolving modules, compiling TypeScript and JSX, bundling, minifying, and serving a fast development server with hot reloading."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Build Tooling"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:caching a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B0%D8%A7%D9%83%D8%B1%D8%A9_%D9%85%D8%AE%D8%A8%D8%A6%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Cache_(computing)> ;
    skos:definition "عملية تخزين نُسَخ من الملفّات في ذاكرة مخبئية، أي في موضع تخزين مؤقّت، ليتسنّى الوصول إليها أسرع."@ar,
        "The process of storing copies of files in a cache, or temporary storage location, so they can be accessed more quickly."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Caching"@en ;
    skos:related wtc:http-https ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:data-acces a skos:Concept ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Data Acces"@en ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:data-encoding a skos:Concept ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Data Encoding"@en ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:html-css a skos:Concept ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "HTML/CSS"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:hydration a skos:Concept ;
    rdfs:seeAlso <https://en.m.wikipedia.org/wiki/Hydration_(web_development)> ;
    skos:definition "الترطيب تقنية في تطوير الويب، ولا سيّما في تطبيقات الصفحة الواحدة (SPAs)، يُعزَّز فيها HTML المصيَّر على الخادوم بجافاسكريبت من جانب العميل. وهذا يجعل الصفحة تفاعلية بـ«ترطيب» المحتوى الساكن بسلوك ديناميكي دون الحاجة إلى إعادة تحميل الصفحة كاملةً."@ar,
        "Hydration is a technique used in web development, particularly in Single Page Applications (SPAs), where server-rendered HTML is enhanced with client-side JavaScript. This allows the page to become interactive by \"hydrating\" static content with dynamic behavior without requiring a full page reload."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Hydration"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:ides a skos:Concept ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "IDEs (Integrated Development Environments)"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:jamstack a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Jamstack> ;
    skos:definition "‏JAMStack، أي جافاسكريبت وواجهات البرمجة والترميز، معمارية حديثة لتطوير الويب تفصل الواجهة الأمامية عن الخلفية. وتقوم على بناء تطبيقات سريعة وآمنة بملفّات ساكنة مصيَّرة مسبقًا تُقدَّم عبر شبكة توصيل محتوى (CDN)، بينما تتولّى واجهات البرمجة الوظائف الديناميكية. وهي تعزّز الأداء وقابلية التوسّع."@ar,
        "JAMStack (JavaScript, APIs, and Markup) is a modern web development architecture that decouples the front-end from the back-end. It involves building fast, secure web apps with pre-rendered static files served over a CDN, while APIs handle dynamic functionality. JAMStack enhances performance and scalability."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "JAMStack"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:nlp-nlu-and-nlg a skos:Concept ;
    skos:broader wtc:statistical-ai ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "NLP (Natural Language Processing), NLU (Natural Language Understanding), and NLG (Natural Language Generation)"@en ;
    wt:status "current" .

wtc:oop a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%85%D8%AC%D8%A9_%D8%BA%D8%B1%D8%B6%D9%8A%D8%A9_%D8%A7%D9%84%D8%AA%D9%88%D8%AC%D9%87>,
        <https://en.wikipedia.org/wiki/Object-oriented_programming> ;
    skos:broader wtc:server-side-programming ;
    skos:definition "البرمجة كائنية التوجّه (OOP) نموذج برمجي يقوم على مفهوم «الكائنات»، وهي نُسَخ من الأصناف (classes). ويستطيع الكائن أن يحوي بيانات على هيئة حقول أي سمات أو خصائص، وشيفرةً على هيئة توابع (methods). ويشدّد هذا النموذج على مبادئ كالتغليف والوراثة وتعدّد الأشكال والتجريد، ممّا يتيح إنشاء شيفرة معيارية قابلة لإعادة الاستعمال. ويُستعمل على نطاق واسع في لغات مثل Java وC++ وPython وJavaScript لبناء تطبيقات قابلة للتوسّع والصيانة."@ar,
        "OOP is a programming paradigm based on the concept of \"objects,\" which are instances of classes. Objects can contain data in the form of fields (attributes or properties) and code in the form of methods (functions). OOP emphasizes principles such as encapsulation, inheritance, polymorphism, and abstraction, allowing for the creation of reusable and modular code. This paradigm is widely used in languages like Java, C++, Python, and JavaScript for building scalable and maintainable applications."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "OOP (Object-Oriented Programming)"@en ;
    wt:status "current" .

wtc:protocols a skos:Concept ;
    skos:broader wtc:networking-2 ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Protocols"@en ;
    wt:status "current" .

wtc:seo a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AA%D8%AD%D8%B3%D9%8A%D9%86_%D9%85%D8%AD%D8%B1%D9%83%D8%A7%D8%AA_%D8%A7%D9%84%D8%A8%D8%AD%D8%AB>,
        <https://en.wikipedia.org/wiki/Search_engine_optimization> ;
    skos:definition "تحسين محرّكات البحث مجموعة ممارسات لزيادة كمّية الزيارات إلى موقعك وجودتها عبر نتائج البحث العضوية."@ar,
        "Search Engine Optimization are set of practices for increasing the quantity and quality of traffic to your website through organic search engine results."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "SEO"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:statistical-ai a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Statistical_learning_theory> ;
    skos:broader wtc:ai ;
    skos:definition "الذكاء الاصطناعي الإحصائي يركّز على المقاربات المدفوعة بالبيانات، مستعملًا الإحصاء والاحتمال لنمذجة عدم اليقين وإصدار التنبّؤات. وتعلُّم الآلة مكوّن أساسيّ فيه، إذ يقوم على خوارزميات تتحسّن بالتجربة والبيانات."@ar,
        "Statistical AI focuses on data-driven approaches, using statistics and probability to model uncertainty and make predictions. Machine learning is a key component of statistical AI, relying on algorithms that improve with experience and data."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Statistical AI"@en ;
    wt:status "current" .

wtc:web-services-and-apis a skos:Concept ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Web Services and APIs"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:ai a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B0%D9%83%D8%A7%D8%A1_%D8%A7%D8%B5%D8%B7%D9%86%D8%A7%D8%B9%D9%8A>,
        <https://en.wikipedia.org/wiki/Artificial_intelligence> ;
    skos:definition "يشير الذكاء الاصطناعي إلى محاكاة الآلات للذكاء البشري، بما يمكّنها من أداء مهامّ كالتعلّم والاستدلال وحلّ المشكلات واتّخاذ القرار. ويتكامل الذكاء الاصطناعي بصورة متزايدة مع تقنيات الويب لتشغيل تطبيقات وخدمات أذكى."@ar,
        "AI refers to the simulation of human intelligence by machines, allowing them to perform tasks such as learning, reasoning, problem-solving, and decision-making. AI is increasingly integrated into web technologies to power smarter applications and services."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "AI (Artificial Intelligence)"@en ;
    skos:related wtc:llm ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:core-web-vitals a skos:Concept ;
    rdfs:seeAlso <https://web.dev/articles/vitals> ;
    skos:definition "مجموعة مقاييس ميدانية من غوغل للأداء كما يدركه المستخدم، تُقاس على زيارات حقيقية لا في المختبر. وهي تحوّل الهدف الغامض «اجعله سريعًا» إلى ثلاثة أرقام محدَّدة يمكن العمل عليها، وتدخل في ترتيب نتائج البحث."@ar,
        "Google's set of field metrics for user-perceived performance, measured on real visits rather than in a lab. They give the vaguer goal of \"make it fast\" three specific numbers to move, and they feed into search ranking."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Core Web Vitals"@en ;
    skos:related wtc:caching,
        wtc:seo ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:docker a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AF%D9%88%D9%83%D8%B1>,
        <https://en.wikipedia.org/wiki/Docker_(software)>,
        <https://www.docker.com/> ;
    skos:definition "دوكر مجموعة من منتجات المنصّة كخدمة (PaaS) تستخدم المحاكاة الافتراضية على مستوى نظام التشغيل (OS-level virtualization) لتسليم البرمجيات في حزم تُسمّى الحاويات (containers)."@ar,
        "Docker is a set of platform-as-a-service products that use OS-level virtualization to deliver software in packages called containers."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Docker"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:http-https a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D8%B1%D9%88%D8%AA%D9%88%D9%83%D9%88%D9%84_%D9%86%D9%82%D9%84_%D8%A7%D9%84%D9%86%D8%B5%D9%88%D8%B5_%D8%A7%D9%84%D8%AA%D8%B1%D8%A7%D8%A8%D8%B7%D9%8A%D8%A9>,
        <https://drive.google.com/drive/folders/1-08W2MmXEgds8Ayn1_mrFKK3JB0JtU1Y>,
        <https://en.wikipedia.org/wiki/Hypertext_Transfer_Protocol>,
        <https://www.w3.org/Protocols/> ;
    skos:broader wtc:protocols ;
    skos:definition "بروتوكول نقل النصّ الفائق (HTTP) هو أساس تبادل البيانات على الشبكة العنكبوتية العالمية (World Wide Web)، أمّا HTTPS فهو نسخته الآمنة التي تستخدم التشفير (encryption)."@ar,
        "Hypertext Transfer Protocol (HTTP) is the foundation of data communication on the World Wide Web, while HTTPS is the secure version using encryption."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "HTTP/HTTPS"@en ;
    wt:status "current" .

wtc:networking-2 a skos:Concept ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Networking"@en ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:sql a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D9%84%D8%BA%D8%A9_%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%B9%D9%84%D8%A7%D9%85%D8%A7%D8%AA_%D8%A7%D9%84%D9%85%D9%87%D9%8A%D9%83%D9%84%D8%A9>,
        <https://en.wikipedia.org/wiki/SQL>,
        <https://youtu.be/YzP164YANAU?si=HygcU6En3Zr4NgB2> ;
    skos:broader wtc:databases-2 ;
    skos:definition "لغة الاستعلام البنيوية (SQL) لغة مِعيارية لإدارة قواعد البيانات العلائقية (relational databases) والتعامل معها."@ar,
        "Structured Query Language (SQL) is a standardized language for managing and manipulating relational databases."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "SQL"@en ;
    wt:status "current" .

wtc:unicode a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A7%D9%84%D8%AA%D8%B1%D9%85%D9%8A%D8%B2_%D8%A7%D9%84%D9%85%D9%88%D8%AD%D8%AF>,
        <https://en.wikipedia.org/wiki/Unicode>,
        <https://home.unicode.org/> ;
    skos:broader wtc:data-encoding ;
    skos:definition "معيار للترميز الموحَّد للنصوص وتمثيلها ومعالجتها بصورة متّسقة، يشمل معظم أنظمة الكتابة في العالم."@ar,
        "A standard for consistent encoding, representation, and handling of text expressed in most of the world's writing systems."@en ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Unicode"@en ;
    wt:status "current" .

wtc:web-frameworks a skos:Concept ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Web Frameworks"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:css3 a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A3%D9%88%D8%B1%D8%A7%D9%82_%D8%A7%D9%84%D8%A3%D9%86%D9%85%D8%A7%D8%B7_%D8%A7%D9%84%D9%85%D8%AA%D8%AA%D8%A7%D9%84%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/CSS>,
        <https://www.w3.org/Style/CSS/>,
        <https://youtu.be/zFZrkCIc2Oc?si=IwtOYBIeU0pHk-Ht> ;
    skos:broader wtc:html-css ;
    skos:definition "أحدث تطوّر للغة صفحات الأنماط المتراصّة (CSS)، ويوفّر خصائص جديدة للتخطيط والحركة وغيرهما."@ar,
        "The latest evolution of the Cascading Style Sheets language, providing new features for layout, animation, and more."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "CSS3"@en ;
    wt:status "current" .

wtc:data-exchange-formats a skos:Concept ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Data Exchange Formats"@en ;
    skos:topConceptOf wts:01-introduction ;
    wt:status "current" .

wtc:meta-frameworks a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A5%D8%B7%D8%A7%D8%B1_%D8%B9%D9%85%D9%84_%D9%88%D9%8A%D8%A8>,
        <https://en.wikipedia.org/wiki/Web_framework> ;
    skos:broader wtc:frameworks-and-libraries ;
    skos:definition "أطر عمل مبنيّة فوق مكتبة واجهة مستخدم لتوفّر ما يحتاجه التطبيق وراء تصيير المكوّنات: التوجيه وتحميل البيانات والتصيير من جانب الخادوم وإعداد البناء والنشر. وهي اليوم نقطة انطلاق معظم عمل الواجهة الأمامية في الإنتاج."@ar,
        "Frameworks built on top of a UI library to supply what an application needs beyond rendering components: routing, data loading, server-side rendering, build configuration and deployment. They are where most production front-end work now starts."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Meta-Frameworks"@en ;
    wt:status "current" .

wtc:defenses a skos:Concept ;
    rdfs:seeAlso <https://developer.mozilla.org/en-US/docs/Web/Security> ;
    skos:definition "الآليات التي تحمي من التهديدات المذكورة أعلاه. والأمن على الويب طبقاتٌ متراكبة: تشفير النقل، والاستيثاق القويّ، وسياسات يفرضها المتصفّح تحدّ ممّا يُسمَح للصفحة بتحميله أو الوصول إليه."@ar,
        "The mechanisms that protect against the threats above. Security on the web is layered: transport encryption, strong authentication, and browser-enforced policies that limit what a page is permitted to load or reach."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Defenses"@en ;
    skos:related wtc:threats ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:devices a skos:Concept ;
    skos:broader wtc:networking-2 ;
    skos:inScheme wts:01-introduction ;
    skos:prefLabel "Devices"@en ;
    wt:status "current" .

wtc:restful-apis a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%B1%D8%B3%D8%AA_%28%D8%A5%D9%86%D8%AA%D8%B1%D9%86%D8%AA%29>,
        <https://en.wikipedia.org/wiki/Representational_state_transfer> ;
    skos:broader wtc:web-services-and-apis ;
    skos:definition "نقل الحالة التمثيلية (REST) نمط معماري لتصميم التطبيقات الشبكية، يتيح الاتّصال بين العميل والخادوم."@ar,
        "Representational State Transfer (REST) is an architectural style for designing networked applications, allowing communication between client and server."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "RESTful APIs"@en ;
    wt:status "current" .

wtc:linked-data a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA_%D9%85%D8%AA%D8%B1%D8%A7%D8%A8%D8%B7%D8%A9>,
        <https://en.wikipedia.org/wiki/Linked_data>,
        <https://www.w3.org/standards/semanticweb/data> ;
    skos:definition "طريقة لنشر البيانات المهيكلة (structured data) بحيث يمكن ربط بعضها ببعض فتغدو أكثر فائدة من خلال الاستعلامات الدلالية (semantic queries)."@ar,
        "A method of publishing structured data so that it can be interlinked and become more useful through semantic queries."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Linked Data"@en ;
    skos:related wtc:uri-url ;
    skos:topConceptOf wts:02-evolution ;
    wt:status "current" .

wtc:odoo-framework a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%A3%D9%88%D8%AF%D9%88>,
        <https://en.wikipedia.org/wiki/Odoo>,
        <https://www.odoo.com/> ;
    skos:definition "حزمة مفتوحة المصدر من تطبيقات الأعمال، تشمل إدارة علاقات العملاء والتجارة الإلكترونية والفوترة والمحاسبة والتصنيع والمستودعات وإدارة المشاريع وإدارة المخزون."@ar,
        "An open-source suite of business applications, including CRM, e-commerce, billing, accounting, manufacturing, warehouse, project management, and inventory management."@en ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Odoo Framework"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:server-side-programming a skos:Concept ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Server-Side Programming"@en ;
    skos:topConceptOf wts:03-web-development ;
    wt:status "current" .

wtc:cloud-computing a skos:Concept ;
    rdfs:seeAlso <https://ar.wikipedia.org/wiki/%D8%AD%D9%88%D8%B3%D8%A8%D8%A9_%D8%B3%D8%AD%D8%A7%D8%A8%D9%8A%D8%A9>,
        <https://en.wikipedia.org/wiki/Cloud_computing> ;
    skos:definition "توفّر الحوسبة السحابية خدمات حوسبية — كالخواديم والتخزين وقواعد البيانات والبرمجيات — عبر الإنترنت. وهي تقدّم المرونة وقابلية التوسّع وكفاءة الكلفة، وتُغني عن البنية التحتية في الموقع. ونماذج الخدمة الرئيسة فيها هي المذكورة أدناه. والحوسبة السحابية أساسية في تطوير الويب الحديث، إذ توفّر الموارد عند الطلب."@ar,
        "Cloud computing delivers computing services—such as servers, storage, databases, and software—over the internet. It offers flexibility, scalability, and cost-efficiency, eliminating the need for on-premise infrastructure. Main service models include: Cloud computing is essential for modern web development, offering resources on demand."@en ;
    skos:inScheme wts:04-additional-topics ;
    skos:prefLabel "Cloud Computing"@en ;
    skos:topConceptOf wts:04-additional-topics ;
    wt:status "current" .

wtc:databases-2 a skos:Concept ;
    skos:inScheme wts:03-web-development ;
    skos:prefLabel "Databases"@en ;
    skos:topConceptOf wts:03-web-development ;
