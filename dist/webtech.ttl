    wt:status "current" .

wtc:statistical-ai a skos:Concept ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Statistical_learning_theory> ;
    skos:broader wtc:ai ;
    skos:definition "Statistical AI focuses on data-driven approaches, using statistics and probability to model uncertainty and make predictions. Machine learning is a key component of statistical AI, relying on algorithms that improve with experience and data."@en ;
    skos:inScheme wts:02-evolution ;
    skos:prefLabel "Statistical AI"@en ;
    wt:status "current" .

wtc:web-frameworks a skos:Concept ;
